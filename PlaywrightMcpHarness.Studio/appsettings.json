{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HarnessConfig": {
    "TestsProjectPath": "../PlaywrightMcpHarness.Tests",
    "ActiveProvider": "GoogleGemini",
    "LlmTimeoutMinutes": 10,
    "Providers": {
      "GoogleGemini": {
        "Type": "Gemini",
        "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "ModelId": "gemini-2.5-flash",
        "ApiKey": ""
      },
      "OpenWebUI": {
        "Type": "OpenWebUI",
        "Endpoint": "http://localhost:3000/api",
        "ModelId": "llama3:latest",
        "ApiKey": ""
      },
      "LocalOllama": {
        "Type": "Ollama",
        "Endpoint": "http://localhost:11434",
        "ModelId": "qwen2.5-coder:14b",
        "ApiKey": ""
      },
      "LMStudioLocal": {
        "Type": "OpenAI",
        "Endpoint": "http://localhost:1234/v1",
        "ModelId": "local-model",
        "ApiKey": "lm-studio"
      },
      "OpenAICloud": {
        "Type": "OpenAI",
        "Endpoint": "https://api.openai.com/v1",
        "ModelId": "gpt-4o",
        "ApiKey": "ENV:OPENAI_API_KEY"
      }
    },
    "PlaywrightMcp": {
      "ServerUrl": "",
      "Command": "npx",
      "Arguments": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--timeout-action",
        "60000"
      ]
    }
  }
}
