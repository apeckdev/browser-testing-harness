@inherits LayoutComponentBase

<div class="h-100 w-100 d-flex flex-column bg-dark text-light overflow-hidden" style="min-height: 0;">
    @Body
</div>

<div id="blazor-error-ui" class="bg-danger text-white p-2 position-fixed bottom-0 start-0 end-0" style="display:none; z-index:9999;">
    An unhandled error has occurred.
    <a href="" class="reload text-white fw-bold ms-2">Reload</a>
    <a class="dismiss text-white fw-bold ms-3" style="cursor:pointer;">🗙</a>
</div>
