<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Browser Testing Harness</title>
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="lib/codemirror/codemirror.min.css" />
    <link rel="stylesheet" href="lib/codemirror/material-darker.min.css" />
    <link rel="stylesheet" href="lib/codemirror/show-hint.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="PlaywrightMcpHarness.Studio.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body class="bg-dark text-light m-0 p-0 overflow-hidden" style="height: 100vh; font-family: 'Inter', sans-serif;">
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="lib/codemirror/codemirror.min.js"></script>
    <script src="lib/codemirror/clike.min.js"></script>
    <script src="lib/codemirror/gherkin.min.js"></script>
    <script src="lib/codemirror/show-hint.min.js"></script>
    <script>
        if (window.CodeMirror) {
            CodeMirror.defineMIME("text/x-gherkin", "gherkin");
            CodeMirror.defineMIME("text/x-feature", "gherkin");

            CodeMirror.registerHelper("hint", "gherkin", function (cm) {
                var cur = cm.getCursor();
                var line = cm.getLine(cur.line);
                var lineToCursor = line.slice(0, cur.ch);

                // Match Given, When, Then, And, But followed by optional query
                var match = lineToCursor.match(/^\s*(Given|When|Then|And|But)\s*(.*)$/i);
                if (!match) return null;

                var kw = match[1];
                var query = match[2] || "";
                var queryStart = cur.ch - query.length;

                var steps = (window.studioCodeEditor && window.studioCodeEditor.stepCatalog) ? window.studioCodeEditor.stepCatalog : [];
                var filtered = steps.filter(function (s) {
                    var targetType = s.stepType || s.StepType || "";
                    if (kw.toLowerCase() !== "and" && kw.toLowerCase() !== "but") {
                        if (targetType.toLowerCase() !== kw.toLowerCase()) {
                            return false;
                        }
                    }
                    if (!query) return true;
                    var pattern = s.normalizedPattern || s.NormalizedPattern || "";
                    return pattern.toLowerCase().includes(query.toLowerCase());
                });

                if (filtered.length === 0) return null;

                var list = filtered.map(function (s) {
                    var pattern = s.normalizedPattern || s.NormalizedPattern || "";
                    var snippet = s.autocompleteSnippet || s.AutocompleteSnippet || pattern;
                    var type = s.stepType || s.StepType || "Step";
                    return {
                        text: snippet,
                        displayText: "[" + type.toUpperCase() + "] " + pattern,
                        className: "cm-step-hint cm-step-" + type.toLowerCase()
                    };
                });

                return {
                    list: list,
                    from: CodeMirror.Pos(cur.line, queryStart),
                    to: CodeMirror.Pos(cur.line, cur.ch)
                };
            });
        }

        window.studioUi = {
            scrollToBottom: function (elementId, force) {
                var el = document.getElementById(elementId);
                if (el) {
                    var isNearBottom = (el.scrollHeight - el.scrollTop - el.clientHeight) < 120;
                    if (force || isNearBottom) {
                        el.scrollTop = el.scrollHeight;
                    }
                }
            }
        };

        window.studioCodeEditor = {
            instance: null,
            dotNetHelper: null,
            updating: false,
            stepCatalog: [],

            setStepCatalog: function (catalog) {
                this.stepCatalog = catalog || [];
            },

            insertSnippet: function (snippet) {
                if (!this.instance) return;
                var doc = this.instance.getDoc();
                var cursor = doc.getCursor();
                doc.replaceRange(snippet, cursor);
                this.instance.focus();
            },

            init: function (textareaId, dotNetRef, mode, initialContent) {
                var el = document.getElementById(textareaId);
                if (!el) return;

                this.dotNetHelper = dotNetRef;
                var self = this;

                if (!this.instance) {
                    this.instance = CodeMirror.fromTextArea(el, {
                        lineNumbers: true,
                        theme: 'material-darker',
                        mode: mode || 'text/x-gherkin',
                        lineWrapping: false,
                        tabSize: 4,
                        indentUnit: 4,
                        indentWithTabs: false,
                        extraKeys: {
                            "Ctrl-Space": function (cm) {
                                if (cm.getOption("mode") === "text/x-gherkin" || cm.getOption("mode") === "gherkin") {
                                    cm.showHint({ hint: CodeMirror.hint.gherkin, completeSingle: false });
                                }
                            }
                        }
                    });

                    this.instance.on('change', function (cm) {
                        if (!self.updating && self.dotNetHelper) {
                            var text = cm.getValue();
                            self.dotNetHelper.invokeMethodAsync('OnEditorContentChanged', text);
                        }
                    });

                    this.instance.on('inputRead', function (cm, change) {
                        var m = cm.getOption("mode");
                        if (m === "text/x-gherkin" || m === "gherkin") {
                            var cur = cm.getCursor();
                            var line = cm.getLine(cur.line);
                            if (/^\s*(Given|When|Then|And|But)\s+/i.test(line)) {
                                if (!cm.state.completionActive) {
                                    cm.showHint({ hint: CodeMirror.hint.gherkin, completeSingle: false });
                                }
                            }
                        }
                    });
                }

                if (initialContent !== undefined && initialContent !== null) {
                    this.setValue(initialContent, mode);
                }

                setTimeout(function () {
                    if (self.instance) self.instance.refresh();
                }, 50);
            },

            setValue: function (val, mode) {
                if (!this.instance) return;
                this.updating = true;
                try {
                    if (this.instance.getValue() !== val) {
                        this.instance.setValue(val || '');
                    }
                    if (mode) {
                        this.instance.setOption('mode', mode);
                    }
                    this.instance.refresh();
                } finally {
                    this.updating = false;
                }
            },

            getValue: function () {
                return this.instance ? this.instance.getValue() : '';
            },

            refresh: function () {
                var self = this;
                setTimeout(function () {
                    if (self.instance) {
                        self.instance.refresh();
                    }
                }, 50);
            }
        };

        window.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                if (window.studioCodeEditor && window.studioCodeEditor.dotNetHelper) {
                    window.studioCodeEditor.dotNetHelper.invokeMethodAsync('OnEscapePressed');
                }
            }
        });
    </script>
</body>

</html>
