    private async Task RefreshTestFiles(string? targetFilePath = null)
    {
        _testFiles = await AgentService.GetExistingTestFilesAsync();
        await StepCatalog.ScanStepDefinitionsAsync(forceReload: true);
        _locatorReport = await LocatorHealthService.AnalyzeTestSuiteLocatorsAsync(forceReload: true);
        _pageObjects = await PageObjectService.GetPageObjectsAsync(forceReload: true);
        _visualSnapshots = await VisualSnapshotService.GetVisualSnapshotsAsync(forceReload: true);
        try
        {
            await JS.InvokeVoidAsync("studioCodeEditor.setStepCatalog", StepCatalog.Steps);
        }
        catch { }

        if (!string.IsNullOrEmpty(targetFilePath))
        {
            var targetNorm = targetFilePath.Replace('/', '\\');
            var targetName = Path.GetFileName(targetFilePath);
            var match = _testFiles.FirstOrDefault(f =>
                string.Equals(f.RelativePath, targetNorm, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(f.RelativePath, targetFilePath, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(f.FileName, targetName, StringComparison.OrdinalIgnoreCase));
            if (match != null)
            {
                _selectedFilePath = match.RelativePath;
                _currentFileContent = match.Content;
                await SyncEditorToCurrentFileAsync();
                return;
            }
        }

        if (!string.IsNullOrEmpty(_selectedFilePath))
        {
            var match = _testFiles.FirstOrDefault(f => string.Equals(f.RelativePath, _selectedFilePath, StringComparison.OrdinalIgnoreCase));
            if (match != null)
            {
                _currentFileContent = match.Content;
                await SyncEditorToCurrentFileAsync();
                return;
            }
        }

        if (_testFiles.Count > 0)
        {
            _selectedFilePath = _testFiles[0].RelativePath;
            _currentFileContent = _testFiles[0].Content;
        }
        else
        {
            _selectedFilePath = "";
            _currentFileContent = "";
        }

        await SyncEditorToCurrentFileAsync();
    }

