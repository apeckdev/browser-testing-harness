    private void CloseAutoHealModal()
    {
        _autoHealCts?.Cancel();
        _isAutoHealing = false;
        _showAutoHealModal = false;
    }

    private async Task TriggerAutoHeal()
    {
        if (_activeAutoHealFinding == null) return;

        _isAutoHealing = true;
        _autoHealErrorMessage = null;
        _autoHealResponse = null;
        _autoHealCts = new CancellationTokenSource();

        try
        {
            var req = new AutoHealRequest
            {
                Finding = _activeAutoHealFinding
            };

            var res = await LocatorHealthService.AutoHealLocatorAsync(
                req,
                _selectedProviderKey,
                _currentProviderOverride,
                _autoHealCts.Token);

            if (res.Success)
            {
                _autoHealResponse = res;
            }
            else
            {
                _autoHealErrorMessage = res.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            _autoHealErrorMessage = ex.Message;
        }
        finally
        {
            _isAutoHealing = false;
            _autoHealCts?.Dispose();
            _autoHealCts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyAutoHealRefactor()
    {
        if (_activeAutoHealFinding == null || _autoHealResponse == null || !_autoHealResponse.Success) return;

        try
        {
            var res = await LocatorHealthService.ApplyLocatorRefactorAsync(
                _activeAutoHealFinding.RelativePath,
                _autoHealResponse.OriginalMethodCode,
                _autoHealResponse.RefactoredMethodCode);

            _statusText = res;
            _showAutoHealModal = false;
            await RefreshTestFiles();
            _locatorReport = await LocatorHealthService.AnalyzeTestSuiteLocatorsAsync(forceReload: true);
        }
        catch (Exception ex)
        {
            _autoHealErrorMessage = $"Failed to apply refactor: {ex.Message}";
        }
    }

