    private void StartOutlineTimer()
    {
        _outlineElapsedSeconds = 0;
        _outlineTimer?.Dispose();
        _outlineTimer = new System.Threading.Timer(async _ =>
        {
            _outlineElapsedSeconds += 0.2;
            if (_outlineElapsedSeconds > 2.0 && _outlineStatusPhase.StartsWith("Connecting"))
            {
                _outlineStatusPhase = "Synthesizing equivalence classes & boundary limits...";
            }
            else if (_outlineElapsedSeconds > 5.0 && _outlineStatusPhase.StartsWith("Synthesizing"))
            {
                _outlineStatusPhase = "Formulating Examples data matrix with edge cases...";
            }
            await InvokeAsync(StateHasChanged);
        }, null, 200, 200);
    }

    private void StopOutlineTimer()
    {
        _outlineTimer?.Dispose();
        _outlineTimer = null;
    }

    private void CancelOutlineGeneration()
    {
        _outlineCts?.Cancel();
        _isGeneratingOutline = false;
        _outlineStatusPhase = "Cancelled";
        StopOutlineTimer();
        _outlineErrorMessage = "Generation was cancelled.";
    }

    private void CloseScenarioOutlineModal()
    {
        CancelOutlineGeneration();
        _showOutlineModal = false;
    }

    private async Task TriggerGenerateOutline()
    {
        if (CurrentSelectedScenario == null) return;

        _isGeneratingOutline = true;
        _outlineErrorMessage = null;
        _generatedOutlineResult = "";
        _outlineStatusPhase = "Connecting to AI model & parsing scenario...";
        StartOutlineTimer();
        _outlineCts = new CancellationTokenSource();

        try
        {
            var req = new GenerateOutlineRequest
            {
                ScenarioText = CurrentSelectedScenario.RawText,
                FeatureName = Path.GetFileName(_selectedFilePath),
                Categories = _edgeCaseOptions,
                MaxExamples = _maxExamples
            };

            var hasReceivedChunk = false;
            await foreach (var chunk in ScenarioOutlineService.StreamGenerateOutlineAsync(
                req,
                _selectedProviderKey,
                _currentProviderOverride,
                _outlineCts.Token))
            {
                if (!hasReceivedChunk)
                {
                    hasReceivedChunk = true;
                    _outlineStatusPhase = "Streaming Scenario Outline & Examples...";
                }
                _generatedOutlineResult += chunk;
                await InvokeAsync(StateHasChanged);
            }

            if (string.IsNullOrWhiteSpace(_generatedOutlineResult))
            {
                _outlineErrorMessage = "AI model returned an empty response. Please verify your API key and model.";
            }
            else
            {
                _generatedOutlineResult = ScenarioOutlineService.SanitizeGherkinOutput(_generatedOutlineResult);
            }
        }
        catch (OperationCanceledException)
        {
            _outlineErrorMessage = "Generation was cancelled.";
        }
        catch (Exception ex)
        {
            _outlineErrorMessage = ex.Message;
        }
        finally
        {
            StopOutlineTimer();
            _isGeneratingOutline = false;
            _outlineCts?.Dispose();
            _outlineCts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyGeneratedOutlineReplace()
    {
        if (CurrentSelectedScenario == null || string.IsNullOrWhiteSpace(_generatedOutlineResult)) return;

        var targetScenario = CurrentSelectedScenario;
        var updated = ScenarioOutlineService.ReplaceScenarioInGherkin(_currentFileContent, targetScenario, _generatedOutlineResult);
        await SaveFileContentAsync(updated);
        _showOutlineModal = false;
        _statusText = $"Replaced scenario '{targetScenario.Title}' with parameterized Scenario Outline.";
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyGeneratedOutlineAppend()
    {
        if (string.IsNullOrWhiteSpace(_generatedOutlineResult)) return;

        var newline = _currentFileContent.Contains("\r\n") ? "\r\n" : "\n";
        var updated = _currentFileContent.TrimEnd() + newline + newline + _generatedOutlineResult.Trim() + newline;
        await SaveFileContentAsync(updated);
        _showOutlineModal = false;
        _statusText = $"Appended new Scenario Outline to {Path.GetFileName(_selectedFilePath)}.";
        await InvokeAsync(StateHasChanged);
    }

    private async Task CopyGeneratedOutline()
    {
        if (string.IsNullOrWhiteSpace(_generatedOutlineResult)) return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedOutlineResult);
            _statusText = "Copied Scenario Outline to clipboard!";
        }
        catch { }
    }

