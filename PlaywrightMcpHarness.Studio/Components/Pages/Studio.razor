            }
            if (!string.IsNullOrWhiteSpace(_locatorSearchQuery))
            {
                var q = _locatorSearchQuery.Trim();
                list = list.Where(f =>
                    f.SourceFile.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    f.MethodName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    f.RawExpression.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    f.IssueReason.Contains(q, StringComparison.OrdinalIgnoreCase));
