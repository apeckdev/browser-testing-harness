@page "/"
@page "/studio"
@rendermode InteractiveServer
@implements IDisposable
@inject IMcpAgentService AgentService
@inject ITestRunnerService TestRunner
@inject IStepCatalogService StepCatalog
@inject IScenarioOutlineService ScenarioOutlineService
@inject ILocatorHealthService LocatorHealthService
@inject IPageObjectService PageObjectService
@inject IVisualSnapshotService VisualSnapshotService
@inject IOptions<HarnessConfig> ConfigOptions
@inject IJSRuntime JS

<PageTitle>Browser Testing Harness</PageTitle>

<div class="d-flex flex-column h-100 w-100 bg-dark text-light overflow-hidden" style="height: 100vh; max-height: 100vh;">
    <!-- Top Navigation & Control Bar -->
    <header class="navbar navbar-dark border-bottom border-secondary border-opacity-25 px-3 py-1 flex-shrink-0 d-flex align-items-center justify-content-between" style="height: 48px; min-height: 48px; max-height: 48px; background-color: #121316; flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden;">
        <div class="d-flex align-items-center gap-2 flex-shrink-0">
            <span class="fs-6 fw-bold d-flex align-items-center gap-2 text-white text-nowrap">
                <i class="bi bi-browser-chrome text-primary"></i>
                Browser Testing Harness
            </span>
            <span class="badge @StatusBadgeClass d-flex align-items-center gap-2 py-1 px-2 border border-secondary border-opacity-25 shadow-sm text-nowrap">
                @if (_isAgentBusy || _isTestRunning)
                {
                    <span class="spinner-grow spinner-grow-sm text-light" role="status" style="width: 0.65rem; height: 0.65rem;"></span>
                }
                else
                {
                    <span class="badge-dot bg-success rounded-circle" style="width: 7px; height: 7px;"></span>
                }
                <span class="text-truncate" style="max-width: 180px;">@_statusText</span>
            </span>

            <!-- AI Chat Collapse / Expand Toggle Button -->
            <button class="btn btn-xs @(_isChatCollapsed ? "btn-outline-info" : "btn-outline-secondary") border-opacity-50 py-1 px-2 d-flex align-items-center gap-1 shadow-sm"
                    title="@(_isChatCollapsed ? "Expand AI Chat Window" : "Collapse AI Chat Window")"
                    @onclick="ToggleChatCollapse">
                <i class="bi @(_isChatCollapsed ? "bi-layout-sidebar-inset" : "bi-layout-sidebar-inset-reverse")"></i>
                <span class="d-none d-md-inline" style="font-size: 0.72rem;">@(_isChatCollapsed ? "Show Chat" : "Hide Chat")</span>
            </button>
        </div>

        <div class="ms-auto d-flex align-items-center gap-2 flex-nowrap flex-shrink-0">
            <!-- AI Provider Selector -->
            <div class="input-group input-group-sm" style="width: 140px;">
                <span class="input-group-text bg-dark text-secondary border-secondary border-opacity-50 px-2">
                    <i class="bi bi-cpu"></i>
                </span>
                <select class="form-select bg-dark text-light border-secondary border-opacity-50 py-1"
                        @bind="_selectedProviderKey"
                        @bind:after="OnProviderChanged">
                    @foreach (var p in _config.Providers.Keys)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>

            <!-- Quick Inline API Key Input (No environment variables or paths needed!) -->
            @if (_currentProviderOverride.Type.Equals("Gemini", StringComparison.OrdinalIgnoreCase) ||
                 _currentProviderOverride.Type.Equals("OpenAI", StringComparison.OrdinalIgnoreCase) ||
                 _currentProviderOverride.Type.Equals("OpenWebUI", StringComparison.OrdinalIgnoreCase))
            {
                <div class="input-group input-group-sm" style="width: 155px;">
                    <span class="input-group-text bg-dark border-secondary border-opacity-50 px-2 @(string.IsNullOrWhiteSpace(_currentProviderOverride.ApiKey) ? "text-warning" : "text-success")"
                          title="@GetApiKeyTitle()">
                        <i class="bi bi-key-fill"></i>
                    </span>
                    <input type="password"
                           class="form-control bg-dark text-light border-secondary border-opacity-50 py-1"
                           placeholder="@GetApiKeyPlaceholder()"
                           @bind="_currentProviderOverride.ApiKey"
                           @bind:after="OnQuickApiKeyChanged" />
                </div>
            }

            <!-- AI Settings Toggle Button -->
            <button class="btn btn-sm btn-outline-secondary border-opacity-50 text-nowrap py-1 px-2"
                    title="Configure AI Endpoint, Model ID, and API Key"
                    @onclick="ToggleSettingsModal">
                <i class="bi bi-gear-fill"></i> Settings
            </button>

            <!-- Run Tests Button -->
            @if (_isTestRunning)
            {
                <button class="btn btn-sm btn-danger d-flex align-items-center gap-1 shadow-sm text-nowrap py-1" @onclick="CancelTestRun">
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    Stop Tests
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-success d-flex align-items-center gap-1 shadow-sm text-nowrap py-1 px-3"
                        @onclick="RunSpecFlowTests"
                        disabled="@(_isAgentBusy)">
                    <i class="bi bi-play-fill fs-6"></i>
                    Run Tests
                </button>
            }
        </div>
    </header>

    <!-- Main Workspace Two-Column Split: takes 100% of remaining height -->
    <div class="d-flex flex-grow-1" style="flex: 1 1 0px; min-height: 0; overflow: hidden;">
        @if (!_isChatCollapsed)
        {
            <!-- Left Pane: AI Exploration Agent & Chat Log -->
            <div class="d-flex flex-column border-end border-secondary border-opacity-25" style="width: 44%; min-width: 320px; min-height: 0; height: 100%; overflow: hidden; background-color: #16181d;">
                <!-- Left Pane Header -->
                <div class="d-flex align-items-center justify-content-between px-3 py-1 border-bottom border-secondary border-opacity-25 flex-shrink-0" style="height: 38px; min-height: 38px; background-color: #1b1e24;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-chat-left-dots-fill text-info"></i>
                        <span class="fw-semibold small text-light">AI Authoring Agent</span>
                        @if (_currentProviderOverride.Type.Equals("Gemini", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25" style="font-size: 0.7rem;">
                                <i class="bi bi-stars"></i> Gemini Active
                            </span>
                        }
                        @if (_currentMcpOverride.IsRemote)
                        {
                            <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-25" style="font-size: 0.7rem;" title="Remote MCP: @_currentMcpOverride.ServerUrl">
                                <i class="bi bi-hdd-network"></i> Remote MCP
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-25" style="font-size: 0.7rem;" title="Local MCP: npx @@playwright/mcp">
                                <i class="bi bi-terminal"></i> Local MCP
                            </span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-xs btn-outline-secondary border-0 text-secondary"
                                title="Reset Agent Conversation"
                                @onclick="ResetAgentConversation"
                                disabled="@_isAgentBusy">
                            <i class="bi bi-arrow-counterclockwise"></i> Reset
                        </button>
                        <button class="btn btn-xs btn-outline-secondary border-0 text-secondary"
                                title="Collapse AI Chat Window"
                                @onclick="ToggleChatCollapse">
                            <i class="bi bi-chevron-bar-left"></i>
                        </button>
                    </div>
                </div>

            <!-- Chat Messages History: flex: 1 1 0px; min-height: 0; overflow-y: auto -->
            <div id="chatScrollArea" class="p-3 d-flex flex-column gap-3" style="flex: 1 1 0px; min-height: 0; overflow-y: auto; overflow-x: hidden; font-size: 0.9rem; scroll-behavior: smooth;">
                @foreach (var msg in AgentService.ConversationHistory.Where(m => m.Role != ChatRole.System))
                {
                    <div class="d-flex flex-column @(msg.Role == ChatRole.User ? "align-items-end" : "align-items-start") w-100">
                        <div class="d-flex align-items-center gap-2 mb-1 px-1">
                            @if (msg.Role == ChatRole.User)
                            {
                                <span class="badge bg-primary bg-opacity-75 text-light" style="font-size: 0.72rem;">User</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary text-light" style="font-size: 0.72rem;">
                                    <i class="bi bi-cpu me-1"></i>Agent (@_selectedProviderKey)
                                </span>
                            }
                        </div>
                        <div class="p-3 rounded-3 shadow-sm border border-secondary border-opacity-25"
                             style="max-width: 92%; word-break: break-word; overflow-wrap: anywhere; font-family: 'Inter', sans-serif; @(msg.Role == ChatRole.User ? "background-color: #273043; color: #f1f5f9;" : "background-color: #1e222b; color: #e2e8f0;")">
                            <div style="white-space: pre-wrap; font-family: inherit;">@msg.Text</div>
                        </div>
                    </div>
                }

                @if (_isAgentBusy && !string.IsNullOrEmpty(_streamingChunk))
                {
                    <div class="d-flex flex-column align-items-start w-100">
                        <div class="d-flex align-items-center gap-2 mb-1 px-1">
                            <span class="badge bg-info text-dark" style="font-size: 0.72rem;">
                                <span class="spinner-border spinner-border-sm me-1" style="width: 0.7rem; height: 0.7rem;"></span>
                                Agent Generating...
                            </span>
                        </div>
                        <div class="p-3 rounded-3 shadow-sm border border-info border-opacity-50"
                             style="max-width: 92%; word-break: break-word; overflow-wrap: anywhere; font-family: 'Inter', sans-serif; background-color: #1b2432; color: #e0f2fe;">
                            <div style="white-space: pre-wrap; font-family: inherit;">@_streamingChunk<span class="cursor-blink">|</span></div>
                        </div>
                    </div>
                }
            </div>

            <!-- Agent Prompt Input Box -->
            <div class="p-2 px-3 border-top border-secondary border-opacity-25 flex-shrink-0" style="background-color: #1b1e24;">
                <div class="input-group">
                    <textarea class="form-control bg-dark text-light border-secondary border-opacity-50 shadow-none"
                              rows="2"
                              placeholder="Describe your test scenario... (e.g., 'Navigate to https://example.com, explore the navigation links, and generate Navigation.feature and NavigationSteps.cs.')"
                              @bind="_promptInput"
                              @bind:event="oninput"
                              @onkeydown="HandleKeyDown"
                              disabled="@_isAgentBusy"></textarea>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <small class="text-secondary" style="font-size: 0.75rem;">
                        <kbd class="bg-secondary bg-opacity-25 text-light">Ctrl+Enter</kbd> to submit
                    </small>
                    <div class="d-flex gap-2">
                        @if (_isAgentBusy)
                        {
                            <button class="btn btn-sm btn-danger px-3 d-flex align-items-center gap-1 shadow-sm" @onclick="CancelAgent">
                                <i class="bi bi-x-circle-fill"></i> Cancel
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-primary px-3 d-flex align-items-center gap-1 shadow-sm"
                                    @onclick="SendPromptToAgent"
                                    disabled="@(string.IsNullOrWhiteSpace(_promptInput))">
                                <i class="bi bi-send-fill"></i> Send
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
        }
        else
        {
            <!-- Left Pane Collapsed Vertical Rail -->
            <div class="d-flex flex-column align-items-center py-2 border-end border-secondary border-opacity-25 flex-shrink-0"
                 style="width: 44px; min-width: 44px; height: 100%; background-color: #16181d; user-select: none;">
                <button class="btn btn-xs btn-outline-secondary border-0 text-info p-1 mb-3"
                        title="Expand AI Chat Window"
                        @onclick="ToggleChatCollapse">
                    <i class="bi bi-chevron-bar-right fs-6"></i>
                </button>
                <div class="d-flex flex-column align-items-center gap-3" role="button" @onclick="ToggleChatCollapse" title="Click to Expand AI Chat Window" style="cursor: pointer;">
                    <i class="bi bi-chat-left-dots-fill text-info fs-6"></i>
                    <div style="writing-mode: vertical-rl; transform: rotate(180deg); font-size: 0.72rem; letter-spacing: 0.08em; color: #94a3b8; font-weight: 600;" class="text-uppercase text-nowrap">
                        AI Authoring Agent
                    </div>
                    @if (_isAgentBusy)
                    {
                        <span class="spinner-grow spinner-grow-sm text-info mt-1" role="status" style="width: 0.6rem; height: 0.6rem;" title="Agent Generating..."></span>
                    }
                </div>
            </div>
        }

        <!-- Right Pane: Code Editor & Live Test Runner Console -->
        <div class="d-flex flex-column flex-grow-1" style="flex: 1 1 0px; min-height: 0; height: 100%; overflow: hidden; background-color: #131418;">
            <!-- Top Half: File Viewer & Tweaker (flex: 1 1 0px; min-height: 0;) -->
            <div class="d-flex flex-column @(_isEditorFullScreen ? "editor-fullscreen-card" : "border-bottom border-secondary border-opacity-25")"
                 style="@(_isEditorFullScreen ? "" : "flex: 1 1 0px; min-height: 0; position: relative; z-index: 20;")">
                <!-- Code Editor Toolbar -->
                <div class="d-flex align-items-center justify-content-between px-3 py-1 border-bottom border-secondary border-opacity-25 flex-shrink-0 gap-2"
                     style="height: 38px; min-height: 38px; background-color: #1a1c22; flex-wrap: nowrap; position: relative; z-index: 1050; overflow: visible;">
                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        <i class="bi bi-file-earmark-code text-warning"></i>
                        <span class="fw-semibold small text-light text-nowrap">Workspace Files</span>
                        <div class="input-group input-group-sm" style="width: 230px;">
                            <select class="form-select bg-dark text-light border-secondary border-opacity-50 py-0"
                                    @bind="_selectedFilePath"
                                    @bind:after="OnFileSelected">
                                @if (_testFiles.Count == 0)
                                {
                                    <option value="">(No test files found)</option>
                                }
                                else
                                {
                                    @foreach (var f in _testFiles)
                                    {
                                        <option value="@f.RelativePath">[@f.FileType] @f.FileName</option>
                                    }
                                }
                            </select>
                        </div>
                        <button class="btn btn-xs btn-outline-secondary border-opacity-50 text-nowrap"
                                title="Refresh files list from disk"
                                @onclick="() => RefreshTestFiles()">
                            <i class="bi bi-arrow-repeat"></i> Refresh
                        </button>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        @if (!string.IsNullOrEmpty(_selectedFilePath))
                        {
                            <button class="btn btn-sm btn-outline-success d-flex align-items-center gap-1 py-0 px-2"
                                    title="Save changes to this file"
                                    @onclick="SaveCurrentFileEdits"
                                    disabled="@(_isAgentBusy || _isTestRunning)">
                                <i class="bi bi-floppy"></i> Save Edits
                            </button>

                            @if (_showDeleteConfirm)
                            {
                                <div class="d-flex align-items-center gap-1 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded px-2 py-0">
                                    <span class="text-danger small" style="font-size: 0.75rem;">Delete file?</span>
                                    <button class="btn btn-sm btn-danger py-0 px-2" style="font-size: 0.75rem;"
                                            @onclick="ConfirmDeleteCurrentFile"
                                            disabled="@(_isAgentBusy || _isTestRunning)">
                                        Confirm
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size: 0.75rem;"
                                            @onclick="() => _showDeleteConfirm = false">
                                        Cancel
                                    </button>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1 py-0 px-2"
                                        title="Delete this file from the test suite"
                                        @onclick="() => _showDeleteConfirm = true"
                                        disabled="@(_isAgentBusy || _isTestRunning)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            }

                            <!-- Suite Tools Dropdown -->
                            <div class="dropdown position-relative">
                                <button class="btn btn-sm btn-outline-info dropdown-toggle d-flex align-items-center gap-1 py-0 px-2"
                                        title="Suite Tools, Catalogs, and Code Generators"
                                        @onclick="() => _showToolsDropdown = !_showToolsDropdown"
                                        @onclick:stopPropagation="true">
                                    <i class="bi bi-tools"></i>
                                    <span style="font-size: 0.75rem;">Tools</span>
                                    @if (_visualSnapshots.Any(s => s.HasDiff))
                                    {
                                        <span class="badge bg-danger rounded-pill px-1" style="font-size: 0.65rem;">@(_visualSnapshots.Count(s => s.HasDiff)) diff</span>
                                    }
                                    else if (_locatorReport != null && _locatorReport.OverallScore < 85)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-1" style="font-size: 0.65rem;">@(_locatorReport.HealthGrade)</span>
                                    }
                                </button>
                                @if (_showToolsDropdown)
                                {
                                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1055;" @onclick="() => _showToolsDropdown = false"></div>
                                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-dark show shadow-lg border-secondary border-opacity-50 py-1"
                                         style="position: absolute; right: 0; top: 100%; margin-top: 4px; z-index: 1060; min-width: 250px; font-size: 0.82rem;"
                                         @onclick:stopPropagation="true">
                                        <div class="dropdown-header text-uppercase text-secondary fw-bold px-3 py-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                            Suite Catalogs & Analysis
                                        </div>
                                        <button class="dropdown-item d-flex align-items-center justify-content-between px-3 py-1 text-light"
                                                @onclick="() => { _showToolsDropdown = false; OpenStepCatalogModal(); }">
                                            <span class="d-flex align-items-center gap-2">
                                                <i class="bi bi-collection text-info"></i> Step Catalog
                                            </span>
                                            <span class="badge bg-info bg-opacity-25 text-info rounded-pill">@StepCatalog.Steps.Count</span>
                                        </button>
                                        <button class="dropdown-item d-flex align-items-center justify-content-between px-3 py-1 text-light"
                                                @onclick="async () => { _showToolsDropdown = false; await OpenVisualModal(); }">
                                            <span class="d-flex align-items-center gap-2">
                                                <i class="bi bi-images text-danger"></i> Visual Baselines
                                            </span>
                                            @if (_visualSnapshots.Any(s => s.HasDiff))
                                            {
                                                <span class="badge bg-danger rounded-pill">@(_visualSnapshots.Count(s => s.HasDiff)) diff</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-50 text-light rounded-pill">@(_visualSnapshots.Count)</span>
                                            }
                                        </button>
                                        <button class="dropdown-item d-flex align-items-center justify-content-between px-3 py-1 text-light"
                                                @onclick="() => { _showToolsDropdown = false; OpenLocatorHealthModal(); }">
                                            <span class="d-flex align-items-center gap-2">
                                                <i class="bi @GetLocatorHealthIconClass()"></i> Locator Health
                                            </span>
                                            <span class="badge @GetLocatorHealthBadgeClass() rounded-pill">@(_locatorReport?.OverallScore ?? 100)% (@(_locatorReport?.HealthGrade ?? "A+"))</span>
                                        </button>
                                        <button class="dropdown-item d-flex align-items-center justify-content-between px-3 py-1 text-light"
                                                @onclick="async () => { _showToolsDropdown = false; await OpenPageObjectCatalogModal(); }">
                                            <span class="d-flex align-items-center gap-2">
                                                <i class="bi bi-layers text-secondary"></i> Page Objects
                                            </span>
                                            <span class="badge bg-secondary bg-opacity-50 text-light rounded-pill">@(_pageObjects.Count)</span>
                                        </button>

                                        @if (_selectedFilePath.EndsWith(".feature", StringComparison.OrdinalIgnoreCase) || _selectedFilePath.EndsWith("Steps.cs", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="dropdown-divider border-secondary border-opacity-25 my-1"></div>
                                            <div class="dropdown-header text-uppercase text-secondary fw-bold px-3 py-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                                AI Authoring Actions
                                            </div>
                                            @if (_selectedFilePath.EndsWith(".feature", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <button class="dropdown-item d-flex align-items-center gap-2 px-3 py-1 text-warning"
                                                        @onclick="async () => { _showToolsDropdown = false; await OpenScenarioOutlineModal(); }">
                                                    <i class="bi bi-grid-3x3-gap-fill"></i> Generate Edge Cases
                                                </button>
                                            }
                                            @if (_selectedFilePath.EndsWith("Steps.cs", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <button class="dropdown-item d-flex align-items-center gap-2 px-3 py-1 text-primary"
                                                        @onclick="() => { _showToolsDropdown = false; OpenExtractPageObjectModal(); }">
                                                    <i class="bi bi-box-arrow-up-right"></i> Extract Page Object
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Full Screen Toggle Button -->
                            <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 py-0 px-2"
                                    title="@(_isEditorFullScreen ? "Exit Full Screen (Esc)" : "Expand Editor to Full Screen")"
                                    @onclick="ToggleEditorFullScreen">
                                <i class="bi @(_isEditorFullScreen ? "bi-fullscreen-exit text-warning" : "bi-arrows-fullscreen")"></i>
                                <span class="d-none d-sm-inline" style="font-size: 0.75rem;">@(_isEditorFullScreen ? "Exit Full Screen" : "Full Screen")</span>
                            </button>
                        }
                    </div>
                </div>

                <!-- Code Editor Area: flex: 1 1 0px; min-height: 0; overflow: hidden; -->
                <div class="p-0 bg-dark d-flex" style="flex: 1 1 0px; min-height: 0; height: calc(100% - 38px); overflow: hidden;">
                    <textarea id="studioCodeTextarea"
                              class="form-control bg-dark text-light border-0 shadow-none h-100 w-100"
                              style="font-family: 'JetBrains Mono', Consolas, monospace; font-size: 0.88rem; line-height: 1.5; resize: none; tab-size: 4; overflow: auto;"
                              placeholder="// Select a .feature or *Steps.cs file above to view and tweak code..."
                              @bind="_currentFileContent"
                              spellcheck="false"></textarea>
                </div>
            </div>

            <!-- Bottom Half: Test Runner Console Output & Detailed Results (flex: 1.2 1 0px; min-height: 0;) -->
            <div class="d-flex flex-column" style="flex: 1.2 1 0px; min-height: 0; position: relative; z-index: 10; background-color: #0d0f12;">
                <!-- Console Toolbar -->
                <div class="d-flex align-items-center justify-content-between px-3 py-1 border-bottom border-secondary border-opacity-25 flex-shrink-0"
                     style="height: 38px; min-height: 38px; background-color: #14171d; position: relative; z-index: 1050; overflow: visible;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-terminal-fill text-success" style="font-size: 0.85rem;"></i>
                        <span class="fw-semibold small text-light" style="font-size: 0.82rem;">Test Runner & Results</span>
                        @if (_isTestRunning)
                        {
                            <span class="badge bg-success bg-opacity-75 text-light" style="font-size: 0.7rem;">
                                <span class="spinner-border spinner-border-sm me-1" style="width: 0.6rem; height: 0.6rem;"></span>Running
                            </span>
                        }
                    </div>

                    <!-- Live Summary Badges -->
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary bg-opacity-50 text-light border border-secondary border-opacity-25" style="font-size: 0.72rem;">
                            Total: @_testScenarios.Count
                        </span>
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25" style="font-size: 0.72rem;">
                            Passed: @_testScenarios.Count(s => s.Passed)
                        </span>
                        @if (_testScenarios.Any(s => !s.Passed))
                        {
                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25" style="font-size: 0.72rem;">
                                Failed: @_testScenarios.Count(s => !s.Passed)
                            </span>
                        }
                    </div>

                    <!-- View Switcher & Actions -->
                    <div class="d-flex align-items-center gap-2">
                        <!-- Playwright Run Settings Dropdown -->
                        <div class="dropdown position-relative">
                            <button class="btn btn-xs btn-outline-secondary border-opacity-50 dropdown-toggle d-flex align-items-center gap-1 text-light py-1 px-2 shadow-sm"
                                    title="Playwright Execution Mode, Scope, and Parallel Settings"
                                    @onclick="() => _showRunSettingsDropdown = !_showRunSettingsDropdown"
                                    @onclick:stopPropagation="true">
                                <i class="bi bi-gear-fill text-secondary"></i>
                                <span style="font-size: 0.73rem;">Settings</span>
                                <span class="text-secondary" style="font-size: 0.68rem;">(@GetRunSettingsSummary())</span>
                            </button>
                            @if (_showRunSettingsDropdown)
                            {
                                <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1055;" @onclick="() => _showRunSettingsDropdown = false"></div>
                                <div class="dropdown-menu dropdown-menu-end dropdown-menu-dark show shadow-lg border-secondary border-opacity-50 p-3"
                                     style="position: absolute; right: 0; top: 100%; margin-top: 4px; z-index: 1060; min-width: 300px;"
                                     @onclick:stopPropagation="true">
                                    <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom border-secondary border-opacity-25">
                                        <span class="fw-bold small text-light d-flex align-items-center gap-1">
                                            <i class="bi bi-sliders2 text-info"></i> Playwright Run Settings
                                        </span>
                                        <button class="btn btn-sm btn-link text-secondary text-decoration-none p-0"
                                                @onclick="() => _showRunSettingsDropdown = false">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>

                                    <!-- Visual Execution Mode -->
                                    <div class="mb-3">
                                        <label class="form-label text-secondary fw-semibold mb-1" style="font-size: 0.75rem;">Browser Visual Mode</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-dark text-secondary border-secondary border-opacity-50 px-2">
                                                <i class="bi bi-eye"></i>
                                            </span>
                                            <select class="form-select bg-dark text-light border-secondary border-opacity-50 py-1" @bind="_selectedVisualMode">
                                                <option value="@VisualExecutionMode.HeadedSlowMo">Visible Browser (Slow 1s)</option>
                                                <option value="@VisualExecutionMode.HeadedNormal">Visible Browser (Full Speed)</option>
                                                <option value="@VisualExecutionMode.Headless">Headless (Background)</option>
                                                <option value="@VisualExecutionMode.Inspector">Playwright Inspector</option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Target Scope -->
                                    <div class="mb-3">
                                        <label class="form-label text-secondary fw-semibold mb-1" style="font-size: 0.75rem;">Target Scope</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-dark text-secondary border-secondary border-opacity-50 px-2">
                                                <i class="bi bi-bullseye"></i>
                                            </span>
                                            <select class="form-select bg-dark text-light border-secondary border-opacity-50 py-1" @bind="_targetScope">
                                                <option value="all">All Features in Suite</option>
                                                <option value="selected">Selected File Only (@(string.IsNullOrEmpty(_selectedFilePath) ? "None selected" : Path.GetFileName(_selectedFilePath)))</option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Concurrency Toggle -->
                                    <div class="p-2 rounded bg-dark border border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                                        <div>
                                            <div class="text-light fw-semibold" style="font-size: 0.75rem;">Concurrency</div>
                                            <div class="text-secondary" style="font-size: 0.68rem;">@(_runInParallel ? "Concurrent test collections" : "Single browser sequential")</div>
                                        </div>
                                        <div class="form-check form-switch m-0">
                                            <input class="form-check-input" type="checkbox" role="switch" id="runnerParallelSwitch" @bind="_runInParallel" />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Run / Stop Tests Button in Runner Header -->
                        @if (_isTestRunning)
                        {
                            <button class="btn btn-xs btn-danger d-flex align-items-center gap-1 shadow-sm px-2 text-nowrap" @onclick="CancelTestRun">
                                <span class="spinner-border spinner-border-sm" role="status" style="width: 0.65rem; height: 0.65rem;"></span>
                                Stop
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-xs btn-success d-flex align-items-center gap-1 shadow-sm px-2 text-nowrap"
                                    @onclick="RunSpecFlowTests"
                                    disabled="@(_isAgentBusy)">
                                <i class="bi bi-play-fill"></i> Run
                            </button>
                        }

                        @if (HasTestFailures)
                        {
                            <button class="btn btn-xs btn-danger d-flex align-items-center gap-1 shadow-sm px-2 text-nowrap"
                                    title="Send test failure logs and scenario details to AI Agent to diagnose and fix"
                                    @onclick="SendFailureToAgent"
                                    disabled="@(_isAgentBusy || _isTestRunning)">
                                <i class="bi bi-bug-fill"></i> Fix with Agent
                            </button>
                        }

                        <div class="btn-group btn-group-xs" role="group">
                            <button type="button" class="btn btn-xs @(_activeConsoleTab == "terminal" ? "btn-secondary text-light fw-semibold" : "btn-outline-secondary text-secondary")"
                                    @onclick='() => _activeConsoleTab = "terminal"'>
                                <i class="bi bi-terminal me-1"></i>Detailed Log
                            </button>
                            <button type="button" class="btn btn-xs @(_activeConsoleTab == "scenarios" ? "btn-secondary text-light fw-semibold" : "btn-outline-secondary text-secondary")"
                                    @onclick='() => _activeConsoleTab = "scenarios"'>
                                <i class="bi bi-check2-circle me-1"></i>Scenarios (@_testScenarios.Count)
                            </button>
                        </div>
                        <button class="btn btn-xs btn-outline-secondary border-0 text-secondary"
                                title="Clear console output"
                                @onclick="ClearConsole">
                            <i class="bi bi-trash3"></i> Clear
                        </button>
                    </div>
                </div>

                <!-- Tab 1: Live Terminal Log: flex: 1 1 0px; min-height: 0; overflow-y: auto; overflow-x: auto; -->
                @if (_activeConsoleTab == "terminal")
                {
                    <div id="consoleScrollArea" class="p-3" style="flex: 1 1 0px; min-height: 0; overflow-y: auto; overflow-x: auto; font-family: 'JetBrains Mono', Consolas, monospace; font-size: 0.82rem; line-height: 1.45; color: #a6adbb;">
                        @if (_testConsoleOutput.Count == 0)
                        {
                            <div class="text-secondary fst-italic">No test output yet. Click 'Run Tests' to execute in the chosen visual mode.</div>
                        }
                        else
                        {
                            @foreach (var line in _testConsoleOutput)
                            {
                                <div class="@GetConsoleLineClass(line)" style="white-space: pre-wrap; word-break: break-all; margin-bottom: 2px;">@line</div>
                            }
                        }
                    </div>
                }
                else
                {
                    <!-- Tab 2: Scenarios Detailed Breakdown: flex: 1 1 0px; min-height: 0; overflow-y: auto; -->
                    <div class="p-3" style="flex: 1 1 0px; min-height: 0; overflow-y: auto;">
                        @if (_testScenarios.Count == 0)
                        {
                            <div class="text-secondary fst-italic">No scenarios recorded yet. Click 'Run Tests' to execute and view scenario results.</div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var sc in _testScenarios)
                                {
                                    <div class="p-2 px-3 rounded-2 border @(sc.Passed ? "border-success border-opacity-25 bg-success bg-opacity-10" : "border-danger border-opacity-50 bg-danger bg-opacity-10") d-flex flex-column gap-2">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center gap-2">
                                                @if (sc.Passed)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success fs-6"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-x-circle-fill text-danger fs-6"></i>
                                                }
                                                <span class="fw-semibold text-light small">@sc.Name</span>
                                                @if (!string.IsNullOrEmpty(sc.ErrorMessage))
                                                {
                                                    <span class="text-danger small ms-2">(@sc.ErrorMessage)</span>
                                                }
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrEmpty(sc.TraceFileName))
                                                {
                                                    <button class="btn btn-xs btn-outline-info d-flex align-items-center gap-1 py-0 px-2"
                                                            title="Launch interactive Playwright Trace Viewer GUI"
                                                            @onclick="() => OpenTraceForScenario(sc)">
                                                        <i class="bi bi-play-circle"></i> Trace
                                                    </button>
                                                    <a href="/test-artifacts/traces/@sc.TraceFileName" download
                                                       class="btn btn-xs btn-outline-secondary py-0 px-2 text-decoration-none"
                                                       title="Download trace .zip file">
                                                        <i class="bi bi-download"></i>
                                                    </a>
                                                }
                                                @if (!sc.Passed)
                                                {
                                                    @if (!string.IsNullOrEmpty(sc.ScreenshotFileName))
                                                    {
                                                        <button class="btn btn-xs btn-outline-warning d-flex align-items-center gap-1 py-0 px-2"
                                                                title="View Failure Screenshot"
                                                                @onclick="() => PreviewScreenshot(sc)">
                                                            <i class="bi bi-image"></i> Screenshot
                                                        </button>
                                                    }
                                                    @if (!string.IsNullOrEmpty(sc.VisualDiffSnapshotName))
                                                    {
                                                        <button class="btn btn-xs btn-outline-danger d-flex align-items-center gap-1 py-0 px-2"
                                                                title="View Visual Diff & Golden Baseline Comparison"
                                                                @onclick="() => OpenVisualDiffForScenario(sc.VisualDiffSnapshotName)">
                                                            <i class="bi bi-images"></i> Visual Diff
                                                            @if (sc.VisualDiffMismatchPercentage.HasValue && sc.VisualDiffMismatchPercentage.Value > 0)
                                                            {
                                                                <span class="badge bg-danger text-light px-1" style="font-size: 0.65rem;">@(sc.VisualDiffMismatchPercentage.Value.ToString("F1"))%</span>
                                                            }
                                                        </button>
                                                    }
                                                    <button class="btn btn-xs btn-outline-danger d-flex align-items-center gap-1 py-0 px-2"
                                                            title="Send this scenario failure to AI Agent to diagnose and fix"
                                                            @onclick="() => SendScenarioFailureToAgent(sc)"
                                                            disabled="@(_isAgentBusy || _isTestRunning)">
                                                        <i class="bi bi-robot"></i> Fix with Agent
                                                    </button>
                                                }
                                                @if (!string.IsNullOrEmpty(sc.Duration))
                                                {
                                                    <span class="badge bg-dark text-secondary border border-secondary border-opacity-25" style="font-size: 0.72rem;">@sc.Duration</span>
                                                }
                                                <span class="badge @(sc.Passed ? "bg-success" : "bg-danger") text-light" style="font-size: 0.72rem;">
                                                    @(sc.Passed ? "Passed" : "Failed")
                                                </span>
                                            </div>
                                        </div>

                                        @if (!sc.Passed && !string.IsNullOrEmpty(sc.VisualDiffSnapshotName))
                                        {
                                            <div class="d-flex align-items-center gap-3 pt-1 border-top border-danger border-opacity-25">
                                                <img src="/test-artifacts/visual/@(sc.VisualDiffSnapshotName).diff.png"
                                                     alt="Visual Regression Diff Preview"
                                                     class="rounded border border-danger border-opacity-50 shadow-sm"
                                                     style="height: 48px; width: 85px; object-fit: cover; cursor: pointer; background: #222;"
                                                     title="Click to inspect visual diff & compare against golden baseline"
                                                     @onclick="() => OpenVisualDiffForScenario(sc.VisualDiffSnapshotName)" />
                                                <div class="small text-secondary">
                                                    <span class="text-danger fw-semibold"><i class="bi bi-images me-1"></i>Visual Regression Detected@(sc.VisualDiffMismatchPercentage.HasValue ? $" ({sc.VisualDiffMismatchPercentage.Value:F1}% pixel diff)" : ""):</span>
                                                    Click thumbnail to inspect curtain split slider or accept as new golden baseline.
                                                </div>
                                            </div>
                                        }

                                        @if (!sc.Passed && !string.IsNullOrEmpty(sc.ScreenshotFileName))
                                        {
                                            <div class="d-flex align-items-center gap-3 pt-1 border-top border-danger border-opacity-25">
                                                <img src="/test-artifacts/screenshots/@sc.ScreenshotFileName"
                                                     alt="Failure Screenshot Preview"
                                                     class="rounded border border-danger border-opacity-50 shadow-sm"
                                                     style="height: 48px; width: 85px; object-fit: cover; cursor: pointer;"
                                                     title="Click to view full-resolution failure screenshot"
                                                     @onclick="() => PreviewScreenshot(sc)" />
                                                <div class="small text-secondary">
                                                    <span class="text-danger fw-semibold"><i class="bi bi-camera-fill me-1"></i>Failure Snapshot Captured:</span>
                                                    Click thumbnail to view screenshot or click <strong class="text-info">Trace</strong> for time-travel debugging.
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal: AI Provider Settings -->
@if (_showSettingsModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-light border border-secondary shadow-lg">
                <div class="modal-header border-secondary border-opacity-50">
                    <h5 class="modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-sliders text-primary"></i>
                        AI & MCP Settings (@_selectedProviderKey)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="ToggleSettingsModal"></button>
                </div>
                <div class="modal-body d-flex flex-column gap-3">
                    <div>
                        <label class="form-label small fw-semibold text-secondary">Provider Type</label>
                        <select class="form-select bg-dark text-light border-secondary border-opacity-50"
                                @bind="_currentProviderOverride.Type"
                                @bind:after="OnTypeChangedInModal">
                            <option value="Gemini">Google Gemini</option>
                            <option value="OpenWebUI">Open WebUI</option>
                            <option value="Ollama">Ollama (Local)</option>
                            <option value="OpenAI">OpenAI / LM Studio / Compatible</option>
                        </select>
                    </div>

                    @if (_currentProviderOverride.Type.Equals("Gemini", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="small text-secondary align-self-center">Model Presets:</span>
                            <button type="button" class="btn btn-xs btn-outline-info" @onclick='() => SetModelPreset("gemini-2.5-flash")'>gemini-2.5-flash</button>
                            <button type="button" class="btn btn-xs btn-outline-info" @onclick='() => SetModelPreset("gemini-2.5-pro")'>gemini-2.5-pro</button>
                            <button type="button" class="btn btn-xs btn-outline-info" @onclick='() => SetModelPreset("gemini-1.5-flash")'>gemini-1.5-flash</button>
                        </div>
                    }

                    @if (_currentProviderOverride.Type.Equals("OpenWebUI", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="small text-secondary align-self-center">Model Presets:</span>
                            <button type="button" class="btn btn-xs btn-outline-info" @onclick='() => SetModelPreset("llama3:latest")'>llama3:latest</button>
                            <button type="button" class="btn btn-xs btn-outline-info" @onclick='() => SetModelPreset("llama3.2:latest")'>llama3.2:latest</button>
                            <button type="button" class="btn btn-xs btn-outline-info" @onclick='() => SetModelPreset("qwen2.5-coder:14b")'>qwen2.5-coder:14b</button>
                            <button type="button" class="btn btn-xs btn-outline-info" @onclick='() => SetModelPreset("mistral:latest")'>mistral:latest</button>
                        </div>
                    }

                    <div>
                        <label class="form-label small fw-semibold text-secondary">Endpoint URL</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary border-opacity-50"
                               placeholder="e.g. https://generativelanguage.googleapis.com/v1beta/openai/ or http://localhost:11434"
                               @bind="_currentProviderOverride.Endpoint" />
                    </div>
                    <div>
                        <label class="form-label small fw-semibold text-secondary">Model ID</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary border-opacity-50"
                               placeholder="e.g. gemini-2.5-flash, qwen2.5-coder:14b, gpt-4o, etc."
                               @bind="_currentProviderOverride.ModelId" />
                    </div>
                    <div>
                        <label class="form-label small fw-semibold text-secondary">API Key (paste directly or use ENV:VAR_NAME)</label>
                        <input type="password" class="form-control bg-dark text-light border-secondary border-opacity-50"
                               placeholder="Paste your Gemini or OpenAI API key here..."
                               @bind="_currentProviderOverride.ApiKey" />
                    </div>
                    <div class="border-top border-secondary border-opacity-25 pt-2">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <label class="form-label small fw-semibold text-secondary mb-0">
                                <i class="bi bi-hdd-network me-1 text-info"></i>Playwright MCP Server Endpoint (Optional)
                            </label>
                            @if (!string.IsNullOrWhiteSpace(_playwrightServerUrl))
                            {
                                <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-25" style="font-size: 0.7rem;">
                                    Remote SSE
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-25" style="font-size: 0.7rem;">
                                    Local Process (npx)
                                </span>
                            }
                        </div>
                        <input type="text" class="form-control bg-dark text-light border-secondary border-opacity-50"
                               placeholder="e.g. http://localhost:8931/sse (leave blank for local npx)"
                               @bind="_playwrightServerUrl" />
                        <div class="form-text text-secondary" style="font-size: 0.75rem;">
                            Leave empty to launch a local browser window via <kbd class="bg-secondary bg-opacity-25 text-light">npx @@playwright/mcp</kbd>. Specify an HTTP/SSE URL to connect to an external or containerized Playwright MCP server.
                        </div>
                    </div>
                    <div class="border-top border-secondary border-opacity-25 pt-2">
                        <div class="form-check form-switch d-flex align-items-center gap-2">
                            <input class="form-check-input mt-0" type="checkbox" role="switch" id="pomSwitch" @bind="_config.UsePageObjectModel" />
                            <label class="form-check-label text-light small fw-semibold user-select-none" for="pomSwitch" style="cursor: pointer;">
                                <i class="bi bi-layers me-1 text-primary"></i>Enable Page Object Model (POM) Mode
                            </label>
                        </div>
                        <div class="form-text text-secondary mt-1" style="font-size: 0.75rem;">
                            When enabled, the AI Agent organizes generated tests into Page Objects in <code>PlaywrightMcpHarness.Tests/Pages/</code> and injects them into SpecFlow step definitions via BoDi DI.
                        </div>
                    </div>
                    <div class="border-top border-secondary border-opacity-25 pt-2">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <label class="form-label small fw-semibold text-secondary mb-0">
                                <i class="bi bi-images me-1 text-danger"></i>Visual Regression Tolerance (%)
                            </label>
                            <span class="badge bg-dark border border-secondary text-info" style="font-size: 0.75rem;">
                                @_config.VisualTolerancePercent%
                            </span>
                        </div>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.05" min="0" max="100" class="form-control bg-dark text-light border-secondary border-opacity-50"
                                   @bind="_config.VisualTolerancePercent" />
                            <span class="input-group-text bg-dark text-secondary border-secondary border-opacity-50">%</span>
                        </div>
                        <div class="form-text text-secondary mt-1" style="font-size: 0.75rem;">
                            Maximum percentage of pixel difference permitted before a visual snapshot test is marked as failed (default: 0.2%).
                        </div>
                    </div>
                    <div class="alert alert-secondary bg-dark border-secondary border-opacity-50 text-secondary mb-0 p-2" style="font-size: 0.8rem;">
                        <i class="bi bi-info-circle me-1"></i>
                        Extended LLM HTTP timeout is set to <strong>@_config.LlmTimeoutMinutes minutes</strong> to comfortably handle slow local LLM accessibility analysis.
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-50">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="ToggleSettingsModal">Close</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveProviderSettings">Save Settings</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Failure Screenshot Preview -->
@if (_previewScenarioScreenshot != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.85); z-index: 1060;" @onclick="CloseScreenshotModal">
        <div class="modal-dialog modal-xl modal-dialog-centered" @onclick:stopPropagation>
            <div class="modal-content bg-dark text-light border border-secondary shadow-lg">
                <div class="modal-header border-secondary border-opacity-50 py-2">
                    <h6 class="modal-title d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-camera-fill text-danger"></i>
                        Failure Snapshot: <span class="text-info">@_previewScenarioScreenshot.Name</span>
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseScreenshotModal"></button>
                </div>
                <div class="modal-body p-2 text-center bg-black d-flex justify-content-center align-items-center" style="min-height: 350px;">
                    <img src="/test-artifacts/screenshots/@_previewScenarioScreenshot.ScreenshotFileName"
                         alt="Failure Screenshot"
                         class="img-fluid rounded border border-secondary shadow"
                         style="max-height: 75vh; width: auto; object-fit: contain;" />
                </div>
                <div class="modal-footer border-secondary border-opacity-50 py-2 d-flex justify-content-between align-items-center">
                    <div class="small text-secondary">
                        Artifact: <code>@_previewScenarioScreenshot.ScreenshotFileName</code>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(_previewScenarioScreenshot.TraceFileName))
                        {
                            <button class="btn btn-sm btn-outline-info d-flex align-items-center gap-1"
                                    @onclick="() => OpenTraceForScenario(_previewScenarioScreenshot)">
                                <i class="bi bi-play-circle"></i> Open in Trace Viewer
                            </button>
                        }
                        <button class="btn btn-sm btn-danger d-flex align-items-center gap-1"
                                @onclick="async () => { var sc = _previewScenarioScreenshot; CloseScreenshotModal(); await SendScenarioFailureToAgent(sc); }">
                            <i class="bi bi-robot"></i> Fix with Agent
                        </button>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseScreenshotModal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Step Definition Catalog & Reusability Library -->
@if (_showStepCatalogModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.8); z-index: 1055;" @onclick="CloseStepCatalogModal">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" @onclick:stopPropagation>
            <div class="modal-content bg-dark text-light border border-secondary shadow-lg">
                <!-- Header -->
                <div class="modal-header border-secondary border-opacity-50 py-2 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-collection-fill text-info fs-5"></i>
                        <div>
                            <h6 class="modal-title mb-0 fw-semibold">SpecFlow Step Definition Catalog</h6>
                            <div class="text-secondary" style="font-size: 0.75rem;">
                                Reusable steps indexed across test suite &bull; Live autocomplete enabled in editor
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1" @onclick="RefreshStepCatalog" title="Re-scan step definition files">
                            <i class="bi bi-arrow-repeat"></i> Rescan
                        </button>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseStepCatalogModal"></button>
                    </div>
                </div>

                <!-- Search & Filter Controls -->
                <div class="p-3 border-bottom border-secondary border-opacity-25 bg-black bg-opacity-25">
                    <div class="row g-2 align-items-center">
                        <div class="col">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-dark border-secondary border-opacity-50 text-secondary">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text" class="form-control bg-dark text-light border-secondary border-opacity-50"
                                       placeholder="Search step pattern, method name, or file..."
                                       @bind="_stepSearchQuery"
                                       @bind:event="oninput" />
                                @if (!string.IsNullOrWhiteSpace(_stepSearchQuery))
                                {
                                    <button class="btn btn-outline-secondary border-secondary border-opacity-50" type="button" @onclick='() => _stepSearchQuery = ""'>
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn @(_stepFilterType == "All" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => _stepFilterType = "All"'>
                                    All (@StepCatalog.Steps.Count)
                                </button>
                                <button type="button" class="btn @(_stepFilterType == "Given" ? "btn-success" : "btn-outline-secondary")" @onclick='() => _stepFilterType = "Given"'>
                                    Given (@StepCatalog.Steps.Count(s => s.StepType == "Given"))
                                </button>
                                <button type="button" class="btn @(_stepFilterType == "When" ? "btn-info" : "btn-outline-secondary")" @onclick='() => _stepFilterType = "When"'>
                                    When (@StepCatalog.Steps.Count(s => s.StepType == "When"))
                                </button>
                                <button type="button" class="btn @(_stepFilterType == "Then" ? "btn-warning" : "btn-outline-secondary")" @onclick='() => _stepFilterType = "Then"'>
                                    Then (@StepCatalog.Steps.Count(s => s.StepType == "Then"))
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Steps List Body -->
                <div class="modal-body p-3" style="max-height: 60vh; overflow-y: auto;">
                    @if (!FilteredCatalogSteps.Any())
                    {
                        <div class="text-center py-4 text-secondary">
                            <i class="bi bi-search fs-3 mb-2 d-block"></i>
                            <span>No step definitions match your search query.</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var step in FilteredCatalogSteps)
                            {
                                var badgeClass = step.StepType switch
                                {
                                    "Given" => "bg-success bg-opacity-25 text-success border border-success border-opacity-50",
                                    "When" => "bg-info bg-opacity-25 text-info border border-info border-opacity-50",
                                    "Then" => "bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50",
                                    _ => "bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-50"
                                };

                                <div class="card bg-black bg-opacity-40 border border-secondary border-opacity-25 p-2 rounded">
                                    <div class="d-flex align-items-start justify-content-between gap-2">
                                        <div class="d-flex flex-column gap-1 flex-grow-1">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="badge @badgeClass fw-bold px-2 py-1" style="font-size: 0.72rem; min-width: 52px; text-align: center;">
                                                    @step.StepType.ToUpperInvariant()
                                                </span>
                                                <span class="font-monospace text-light fw-medium" style="font-size: 0.88rem;">
                                                    @step.NormalizedPattern
                                                </span>
                                            </div>
                                            <div class="d-flex align-items-center gap-3 text-secondary" style="font-size: 0.75rem;">
                                                <span><i class="bi bi-file-earmark-code me-1 text-info"></i>@step.SourceFile:@step.LineNumber</span>
                                                <span><i class="bi bi-code-slash me-1"></i><code>@step.MethodName</code></span>
                                                @if (step.Parameters.Count > 0)
                                                {
                                                    <span>
                                                        <i class="bi bi-braces me-1"></i>
                                                        @string.Join(", ", step.Parameters.Select(p => $"{p.Type} {p.Name}"))
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                            <button class="btn btn-xs btn-outline-primary d-flex align-items-center gap-1"
                                                    title="Insert into currently open file at cursor"
                                                    @onclick="() => InsertStepIntoEditor(step)">
                                                <i class="bi bi-box-arrow-in-down"></i> Insert
                                            </button>
                                            <button class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1"
                                                    title="Copy Gherkin step to clipboard"
                                                    @onclick="() => CopyStepToClipboard(step)">
                                                <i class="bi bi-clipboard"></i> Copy
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Footer -->
                <div class="modal-footer border-secondary border-opacity-50 py-2 d-flex justify-content-between">
                    <span class="text-secondary small" style="font-size: 0.75rem;">
                        <i class="bi bi-lightbulb text-warning me-1"></i>
                        Tip: In the editor, type <kbd class="bg-secondary bg-opacity-25 text-light">Given </kbd>, <kbd class="bg-secondary bg-opacity-25 text-light">When </kbd>, or press <kbd class="bg-secondary bg-opacity-25 text-light">Ctrl+Space</kbd> for instant autocomplete.
                    </span>
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseStepCatalogModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: AI Edge-Case & Scenario Outline Generator -->
@if (_showOutlineModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.8); z-index: 1056;" @onclick="CloseScenarioOutlineModal">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" @onclick:stopPropagation>
            <div class="modal-content bg-dark text-light border border-secondary shadow-lg">
                <!-- Header -->
                <div class="modal-header border-secondary border-opacity-50 py-2 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-grid-3x3-gap-fill text-warning fs-5"></i>
                        <div>
                            <h6 class="modal-title mb-0 fw-semibold">AI Edge-Case & Scenario Outline Generator</h6>
                            <div class="text-secondary" style="font-size: 0.75rem;">
                                Automatically parameterize scenarios and build a comprehensive test data matrix
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseScenarioOutlineModal"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-3">
                    <div class="row g-3">
                        <!-- Left Panel: Scenario Selection & Category Toggles -->
                        <div class="col-lg-5 d-flex flex-column gap-3 border-end border-secondary border-opacity-25 pe-3">
                            <div>
                                <label class="form-label small fw-semibold text-secondary mb-1">
                                    <i class="bi bi-file-earmark-text me-1 text-info"></i>Select Scenario to Parameterize:
                                </label>
                                @if (_detectedScenarios.Count == 0)
                                {
                                    <div class="alert alert-secondary py-1 px-2 small mb-0">No scenarios detected in open file.</div>
                                }
                                else
                                {
                                    <select class="form-select form-select-sm bg-dark text-light border-secondary border-opacity-50"
                                            @bind="_selectedScenarioIndex">
                                        @for (int i = 0; i < _detectedScenarios.Count; i++)
                                        {
                                            var sc = _detectedScenarios[i];
                                            <option value="@i">
                                                @(sc.IsOutline ? "[Outline]" : "[Scenario]") @sc.Title (Lines @sc.StartLine-@sc.EndLine)
                                            </option>
                                        }
                                    </select>
                                }
                            </div>

                            @if (CurrentSelectedScenario != null)
                            {
                                <div>
                                    <label class="form-label small fw-semibold text-secondary mb-1">Original Scenario Preview:</label>
                                    <pre class="bg-black bg-opacity-50 p-2 rounded text-light font-monospace small mb-0 border border-secondary border-opacity-25"
                                         style="max-height: 120px; overflow-y: auto; font-size: 0.78rem;">@CurrentSelectedScenario.RawText</pre>
                                </div>
                            }

                            <div>
                                <label class="form-label small fw-semibold text-secondary mb-1">
                                    <i class="bi bi-sliders me-1 text-warning"></i>Edge-Case Categories to Include:
                                </label>
                                <div class="d-flex flex-column gap-1 bg-black bg-opacity-30 p-2 rounded border border-secondary border-opacity-25">
                                    <div class="form-check form-switch small">
                                        <input class="form-check-input" type="checkbox" id="catHappy" @bind="_edgeCaseOptions.IncludeHappyPath" />
                                        <label class="form-check-label text-light" for="catHappy">
                                            <strong>Happy Path</strong> <span class="text-secondary">(Valid equivalence classes)</span>
                                        </label>
                                    </div>
                                    <div class="form-check form-switch small">
                                        <input class="form-check-input" type="checkbox" id="catBoundaries" @bind="_edgeCaseOptions.IncludeBoundaryLimits" />
                                        <label class="form-check-label text-light" for="catBoundaries">
                                            <strong>Boundary Limits</strong> <span class="text-secondary">(1-char min, max field lengths)</span>
                                        </label>
                                    </div>
                                    <div class="form-check form-switch small">
                                        <input class="form-check-input" type="checkbox" id="catEmpty" @bind="_edgeCaseOptions.IncludeEmptyAndWhitespace" />
                                        <label class="form-check-label text-light" for="catEmpty">
                                            <strong>Empty & Whitespace</strong> <span class="text-secondary">(Blank, spaces only, missing)</span>
                                        </label>
                                    </div>
                                    <div class="form-check form-switch small">
                                        <input class="form-check-input" type="checkbox" id="catSpecial" @bind="_edgeCaseOptions.IncludeSpecialCharsAndUnicode" />
                                        <label class="form-check-label text-light" for="catSpecial">
                                            <strong>Unicode & Special Chars</strong> <span class="text-secondary">(Accents René, O'Connor, symbols)</span>
                                        </label>
                                    </div>
                                    <div class="form-check form-switch small">
                                        <input class="form-check-input" type="checkbox" id="catSecurity" @bind="_edgeCaseOptions.IncludeSecuritySanity" />
                                        <label class="form-check-label text-light" for="catSecurity">
                                            <strong>Security Sanity</strong> <span class="text-secondary">(HTML/XSS &lt;script&gt;, SQL quotes)</span>
                                        </label>
                                    </div>
                                    <div class="form-check form-switch small">
                                        <input class="form-check-input" type="checkbox" id="catMalformed" @bind="_edgeCaseOptions.IncludeMalformedFormats" />
                                        <label class="form-check-label text-light" for="catMalformed">
                                            <strong>Malformed Formats</strong> <span class="text-secondary">(Invalid email/URL structure)</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-between">
                                <label class="form-label small fw-semibold text-secondary mb-0">Max Example Rows:</label>
                                <select class="form-select form-select-sm bg-dark text-light border-secondary border-opacity-50" style="width: 100px;" @bind="_maxExamples">
                                    <option value="4">4 rows</option>
                                    <option value="6">6 rows</option>
                                    <option value="8">8 rows</option>
                                    <option value="12">12 rows</option>
                                </select>
                            </div>

                            <button class="btn btn-warning w-100 d-flex align-items-center justify-content-center gap-2 fw-semibold shadow-sm"
                                    @onclick="TriggerGenerateOutline"
                                    disabled="@(_isGeneratingOutline || CurrentSelectedScenario == null)">
                                @if (_isGeneratingOutline)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>Generating (@_outlineElapsedSeconds.ToString("0.0")s)...</span>
                                }
                                else
                                {
                                    <i class="bi bi-magic"></i>
                                    <span>Generate Scenario Outline</span>
                                }
                            </button>

                            @if (!string.IsNullOrEmpty(_outlineErrorMessage))
                            {
                                <div class="alert alert-danger py-1 px-2 small mb-0">
                                    <i class="bi bi-exclamation-triangle me-1"></i>@_outlineErrorMessage
                                </div>
                            }
                        </div>

                        <!-- Right Panel: Generated Gherkin Preview -->
                        <div class="col-lg-7 d-flex flex-column gap-2">
                            <div class="d-flex align-items-center justify-content-between">
                                <label class="form-label small fw-semibold text-secondary mb-0">
                                    <i class="bi bi-code-square me-1 text-info"></i>Generated Scenario Outline:
                                </label>
                                @if (_isGeneratingOutline)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50" style="font-size: 0.72rem;">
                                            <span class="spinner-border spinner-border-sm me-1" style="width: 0.65rem; height: 0.65rem;" role="status"></span>
                                            Generating (@_outlineElapsedSeconds.ToString("0.0")s)
                                        </span>
                                        <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2" style="font-size: 0.7rem;" @onclick="CancelOutlineGeneration">
                                            <i class="bi bi-x-circle me-1"></i>Cancel
                                        </button>
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_generatedOutlineResult))
                                {
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50" style="font-size: 0.72rem;">
                                        <i class="bi bi-check-circle me-1"></i>Ready to Apply
                                    </span>
                                }
                            </div>

                            @if (_isGeneratingOutline && string.IsNullOrWhiteSpace(_generatedOutlineResult))
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 bg-black bg-opacity-40 rounded border border-warning border-opacity-25 p-4 text-center" style="min-height: 320px;">
                                    <div class="spinner-border text-warning mb-3" style="width: 2.2rem; height: 2.2rem;" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <div class="fw-semibold text-warning mb-1" style="font-size: 0.95rem;">@_outlineStatusPhase</div>
                                    <div class="small text-secondary mb-3">
                                        Elapsed: <strong class="text-light">@_outlineElapsedSeconds.ToString("0.0")s</strong> &bull; Model: <span class="text-info">@_currentProviderOverride.ModelId</span>
                                    </div>
                                    <div class="progress bg-dark border border-secondary border-opacity-25 mb-3" style="height: 6px; width: 65%;">
                                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning" style="width: 100%"></div>
                                    </div>
                                    <div class="text-secondary small fst-italic" style="font-size: 0.78rem;">
                                        Synthesizing boundary conditions and formatting parameterized SpecFlow Examples table...
                                    </div>
                                </div>
                            }
                            else if (string.IsNullOrWhiteSpace(_generatedOutlineResult))
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 bg-black bg-opacity-30 rounded border border-secondary border-opacity-25 p-4 text-center text-secondary" style="min-height: 320px;">
                                    <i class="bi bi-grid-3x3-gap display-4 mb-2 opacity-50"></i>
                                    <div class="fw-semibold">No outline generated yet</div>
                                    <div class="small text-secondary">
                                        Select a scenario on the left, check desired edge-case categories, and click <strong>Generate Scenario Outline</strong>.
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="position-relative flex-grow-1 d-flex flex-column">
                                    @if (_isGeneratingOutline)
                                    {
                                        <div class="position-absolute top-0 end-0 m-2 badge bg-dark text-warning border border-warning border-opacity-50 small shadow-sm z-3" style="font-size: 0.72rem;">
                                            <span class="spinner-grow spinner-grow-sm me-1" style="width: 0.5rem; height: 0.5rem;" role="status"></span>
                                            Streaming live (@_outlineElapsedSeconds.ToString("0.0")s)...
                                        </div>
                                    }
                                    <pre class="bg-black p-3 rounded text-info font-monospace small mb-0 border border-info border-opacity-25 flex-grow-1"
                                         style="min-height: 320px; max-height: 480px; overflow-y: auto; white-space: pre; line-height: 1.5; font-size: 0.82rem;">@_generatedOutlineResult<span class="@(_isGeneratingOutline ? "cursor-blink text-warning" : "d-none")">▋</span></pre>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Footer Actions -->
                <div class="modal-footer border-secondary border-opacity-50 py-2 d-flex justify-content-between align-items-center">
                    <div class="small text-secondary">
                        Using active AI model: <strong class="text-light">@_currentProviderOverride.ModelId</strong> (@_selectedProviderKey)
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrWhiteSpace(_generatedOutlineResult))
                        {
                            <button type="button" class="btn btn-sm btn-success d-flex align-items-center gap-1"
                                    @onclick="ApplyGeneratedOutlineReplace"
                                    title="Replace the original scenario in the open file with this outline">
                                <i class="bi bi-arrow-repeat"></i> Replace Original Scenario
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info d-flex align-items-center gap-1"
                                    @onclick="ApplyGeneratedOutlineAppend"
                                    title="Append this outline to the bottom of the open file">
                                <i class="bi bi-plus-circle"></i> Append as New Outline
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                                    @onclick="CopyGeneratedOutline">
                                <i class="bi bi-clipboard"></i> Copy
                            </button>
                        }
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseScenarioOutlineModal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Playwright Locator Health & Best Practices Linter -->
@if (_showLocatorHealthModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.8); z-index: 1056;" @onclick="CloseLocatorHealthModal">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" @onclick:stopPropagation>
            <div class="modal-content bg-dark text-light border border-secondary shadow-lg">
                <!-- Header -->
                <div class="modal-header border-secondary border-opacity-50 py-2 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi @GetLocatorHealthIconClass() fs-5"></i>
                        <div>
                            <h6 class="modal-title mb-0 fw-semibold">Playwright Locator Health & Best Practices Linter</h6>
                            <div class="text-secondary" style="font-size: 0.75rem;">
                                Automated static analysis against official Playwright user-facing locator principles
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-xs btn-outline-info d-flex align-items-center gap-1"
                                title="Re-scan step definition files"
                                @onclick="RefreshLocatorHealth">
                            <i class="bi bi-arrow-repeat"></i> Re-Scan Suite
                        </button>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseLocatorHealthModal"></button>
                    </div>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-3 d-flex flex-column gap-3">
                    <!-- Top Metric Cards -->
                    <div class="row g-2">
                        <!-- Score Card -->
                        <div class="col-md-3">
                            <div class="bg-black bg-opacity-40 p-3 rounded border border-secondary border-opacity-25 d-flex align-items-center justify-content-between h-100">
                                <div>
                                    <div class="text-secondary small fw-semibold text-uppercase">Suite Health Score</div>
                                    <div class="d-flex align-items-baseline gap-2 mt-1">
                                        <span class="fs-3 fw-bold @GetLocatorHealthTextColor()">@(_locatorReport?.OverallScore ?? 100)%</span>
                                        <span class="badge @GetLocatorHealthBadgeClass() fs-6">Grade @(_locatorReport?.HealthGrade ?? "A+")</span>
                                    </div>
                                    <div class="small text-secondary mt-1" style="font-size: 0.72rem;">
                                        @(_locatorReport?.TotalLocators ?? 0) total locators inspected
                                    </div>
                                </div>
                                <i class="bi @GetLocatorHealthIconClass() display-6 @GetLocatorHealthTextColor() opacity-75"></i>
                            </div>
                        </div>

                        <!-- Resilient Card -->
                        <div class="col-md-3">
                            <div class="bg-black bg-opacity-40 p-3 rounded border border-success border-opacity-25 d-flex align-items-center justify-content-between h-100">
                                <div>
                                    <div class="text-success small fw-semibold text-uppercase">
                                        <i class="bi bi-check-circle-fill me-1"></i>Resilient
                                    </div>
                                    <div class="fs-3 fw-bold text-light mt-1">@(_locatorReport?.ResilientCount ?? 0)</div>
                                    <div class="small text-secondary mt-1" style="font-size: 0.72rem;">
                                        GetByRole, GetByLabel, GetByTestId
                                    </div>
                                </div>
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 fs-6">
                                    @(GetPercentage(_locatorReport?.ResilientCount ?? 0, _locatorReport?.TotalLocators ?? 0))%
                                </span>
                            </div>
                        </div>

                        <!-- Caution Card -->
                        <div class="col-md-3">
                            <div class="bg-black bg-opacity-40 p-3 rounded border border-warning border-opacity-25 d-flex align-items-center justify-content-between h-100">
                                <div>
                                    <div class="text-warning small fw-semibold text-uppercase">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Caution / Warning
                                    </div>
                                    <div class="fs-3 fw-bold text-light mt-1">@(_locatorReport?.CautionCount ?? 0)</div>
                                    <div class="small text-secondary mt-1" style="font-size: 0.72rem;">
                                        #id, attribute selectors
                                    </div>
                                </div>
                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 fs-6">
                                    @(GetPercentage(_locatorReport?.CautionCount ?? 0, _locatorReport?.TotalLocators ?? 0))%
                                </span>
                            </div>
                        </div>

                        <!-- Fragile Card -->
                        <div class="col-md-3">
                            <div class="bg-black bg-opacity-40 p-3 rounded border border-danger border-opacity-25 d-flex align-items-center justify-content-between h-100">
                                <div>
                                    <div class="text-danger small fw-semibold text-uppercase">
                                        <i class="bi bi-x-circle-fill me-1"></i>Fragile / Antipattern
                                    </div>
                                    <div class="fs-3 fw-bold text-light mt-1">@(_locatorReport?.FragileCount ?? 0)</div>
                                    <div class="small text-secondary mt-1" style="font-size: 0.72rem;">
                                        :nth-child, XPath, bare tags
                                    </div>
                                </div>
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 fs-6">
                                    @(GetPercentage(_locatorReport?.FragileCount ?? 0, _locatorReport?.TotalLocators ?? 0))%
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Filter Bar & Search -->
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn @(_locatorTierFilter == null ? "btn-info" : "btn-outline-secondary")"
                                    @onclick="() => _locatorTierFilter = null">
                                All (@(_locatorReport?.TotalLocators ?? 0))
                            </button>
                            <button type="button" class="btn @(_locatorTierFilter == LocatorHealthTier.Fragile ? "btn-danger" : "btn-outline-danger")"
                                    @onclick="() => _locatorTierFilter = LocatorHealthTier.Fragile">
                                <i class="bi bi-x-circle me-1"></i>Fragile Only (@(_locatorReport?.FragileCount ?? 0))
                            </button>
                            <button type="button" class="btn @(_locatorTierFilter == LocatorHealthTier.Caution ? "btn-warning" : "btn-outline-warning")"
                                    @onclick="() => _locatorTierFilter = LocatorHealthTier.Caution">
                                <i class="bi bi-exclamation-triangle me-1"></i>Caution (@(_locatorReport?.CautionCount ?? 0))
                            </button>
                            <button type="button" class="btn @(_locatorTierFilter == LocatorHealthTier.Resilient ? "btn-success" : "btn-outline-success")"
                                    @onclick="() => _locatorTierFilter = LocatorHealthTier.Resilient">
                                <i class="bi bi-check-circle me-1"></i>Resilient (@(_locatorReport?.ResilientCount ?? 0))
                            </button>
                        </div>

                        <div class="input-group input-group-sm" style="width: 260px;">
                            <span class="input-group-text bg-dark text-secondary border-secondary border-opacity-50">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" class="form-control bg-dark text-light border-secondary border-opacity-50"
                                   placeholder="Filter by file, method, or selector..."
                                   @bind="_locatorSearchQuery"
                                   @bind:event="oninput" />
                        </div>
                    </div>

                    <!-- Findings Table -->
                    <div class="border border-secondary border-opacity-25 rounded" style="max-height: 480px; overflow-y: auto; overflow-x: auto;">
                        <table class="table table-dark table-hover table-sm mb-0 align-middle" style="font-size: 0.82rem;">
                            <thead class="table-dark sticky-top border-bottom border-secondary border-opacity-50 text-secondary small" style="position: sticky; top: 0; z-index: 5; background-color: #181b20;">
                                <tr>
                                    <th style="width: 110px; background-color: #181b20;">Health Tier</th>
                                    <th style="width: 180px; background-color: #181b20;">Source File & Step</th>
                                    <th style="background-color: #181b20;">Locator Expression</th>
                                    <th style="background-color: #181b20;">Linter Diagnostic & Best Practice</th>
                                    <th style="width: 120px; background-color: #181b20;" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (FilteredLocatorFindings.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-secondary">
                                            <i class="bi bi-shield-check display-6 d-block mb-2 text-success opacity-50"></i>
                                            No locators match the selected filter.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var finding in FilteredLocatorFindings)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge @GetFindingBadgeClass(finding.HealthTier) d-inline-flex align-items-center gap-1" style="font-size: 0.72rem;">
                                                    <i class="bi @GetFindingIconClass(finding.HealthTier)"></i>
                                                    @finding.HealthTier (@finding.HealthScore)
                                                </span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-info" role="button" @onclick="() => NavigateToFindingFile(finding)" title="Open in editor">
                                                    @finding.SourceFile:L@($"{finding.LineNumber}")
                                                </div>
                                                <div class="small text-secondary text-truncate" style="max-width: 170px;" title="@finding.MethodName">
                                                    @finding.MethodName
                                                </div>
                                            </td>
                                            <td>
                                                <code class="text-warning font-monospace" style="font-size: 0.78rem;">@finding.RawExpression</code>
                                                <div class="text-secondary small" style="font-size: 0.72rem;">Type: @finding.LocatorType</div>
                                            </td>
                                            <td>
                                                <div class="text-light small">@finding.IssueReason</div>
                                                <div class="text-info small mt-1">
                                                    <i class="bi bi-lightbulb me-1 text-warning"></i>@finding.Recommendation
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                @if (finding.HealthTier != LocatorHealthTier.Resilient)
                                                {
                                                    <button type="button" class="btn btn-xs btn-outline-warning d-inline-flex align-items-center gap-1"
                                                            title="Auto-heal this locator using AI refactoring"
                                                            @onclick="() => OpenAutoHealForFinding(finding)">
                                                        <i class="bi bi-magic"></i> Auto-Heal
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-success small"><i class="bi bi-check-all"></i> Healthy</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer border-secondary border-opacity-50 py-2 d-flex justify-content-between align-items-center">
                    <div class="small text-secondary">
                        Playwright Best Practices: Prioritize <strong class="text-light">GetByRole</strong>, <strong class="text-light">GetByLabel</strong>, and semantic accessibility contracts.
                    </div>
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseLocatorHealthModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: AI Auto-Heal Locator Refactor -->
@if (_showAutoHealModal && _activeAutoHealFinding != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.85); z-index: 1058;" @onclick="CloseAutoHealModal">
        <div class="modal-dialog modal-lg modal-dialog-centered" @onclick:stopPropagation>
            <div class="modal-content bg-dark text-light border border-warning shadow-lg">
                <div class="modal-header border-secondary border-opacity-50 py-2 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-magic text-warning fs-5"></i>
                        <h6 class="modal-title mb-0 fw-semibold">Auto-Heal Locator with AI</h6>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseAutoHealModal"></button>
                </div>

                <div class="modal-body p-3 d-flex flex-column gap-3">
                    <div class="alert alert-secondary py-2 px-3 small mb-0 border-secondary border-opacity-25 bg-black bg-opacity-30">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="fw-semibold text-warning">Target: @_activeAutoHealFinding.SourceFile (Line @_activeAutoHealFinding.LineNumber)</span>
                            <span class="badge @GetFindingBadgeClass(_activeAutoHealFinding.HealthTier)">@_activeAutoHealFinding.HealthTier</span>
                        </div>
                        <div class="text-secondary">Current Locator: <code class="text-warning font-monospace">@_activeAutoHealFinding.RawExpression</code></div>
                        <div class="text-light mt-1">Issue: @_activeAutoHealFinding.IssueReason</div>
                    </div>

                    @if (_isAutoHealing)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center p-4 bg-black bg-opacity-40 rounded border border-warning border-opacity-25 text-center" style="min-height: 200px;">
                            <div class="spinner-border text-warning mb-2" role="status"></div>
                            <div class="fw-semibold text-warning">Synthesizing Resilient Playwright Locator...</div>
                            <div class="small text-secondary">Analyzing method structure and identifying accessible user-facing role/label</div>
                        </div>
                    }
                    else if (_autoHealResponse != null && _autoHealResponse.Success)
                    {
                        <div>
                            <label class="form-label small fw-semibold text-success mb-1">
                                <i class="bi bi-check-circle me-1"></i>Refactored Method Preview (Playwright Best Practice):
                            </label>
                            <pre class="bg-black p-3 rounded text-info font-monospace small mb-2 border border-success border-opacity-50" style="max-height: 220px; overflow-y: auto; font-size: 0.8rem;">@_autoHealResponse.RefactoredMethodCode</pre>
                            @if (!string.IsNullOrWhiteSpace(_autoHealResponse.Explanation))
                            {
                                <div class="small text-secondary bg-black bg-opacity-30 p-2 rounded border border-secondary border-opacity-25">
                                    <strong class="text-light">Why this is more resilient:</strong> @_autoHealResponse.Explanation
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_autoHealErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>@_autoHealErrorMessage
                        </div>
                    }
                </div>

                <div class="modal-footer border-secondary border-opacity-50 py-2 d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-sm btn-outline-warning" @onclick="TriggerAutoHeal" disabled="@_isAutoHealing">
                        <i class="bi bi-arrow-repeat"></i> Regenerate
                    </button>
                    <div class="d-flex align-items-center gap-2">
                        @if (_autoHealResponse != null && _autoHealResponse.Success)
                        {
                            <button type="button" class="btn btn-sm btn-success d-flex align-items-center gap-1"
                                    @onclick="ApplyAutoHealRefactor">
                                <i class="bi bi-check2-circle"></i> Apply Fix to Step Definition
                            </button>
                        }
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseAutoHealModal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: AI Extract Page Object Refactor -->
@if (_showExtractPoModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.85); z-index: 1060;" @onclick="CloseExtractPageObjectModal">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" @onclick:stopPropagation>
            <div class="modal-content bg-dark text-light border border-primary shadow-lg" style="max-height: 90vh;">
                <div class="modal-header border-secondary border-opacity-50 py-2 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-box-arrow-up-right text-primary fs-5"></i>
                        <div>
                            <h6 class="modal-title mb-0 fw-semibold">Extract Page Object Model with AI</h6>
                            <span class="small text-secondary">Source: @_selectedFilePath</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseExtractPageObjectModal"></button>
                </div>

                <div class="modal-body p-3 d-flex flex-column gap-3" style="overflow-y: auto;">
                    <!-- Configuration & Input Controls -->
                    <div class="row g-2">
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold text-light mb-1">Target Page Object Name</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-black border-secondary border-opacity-50 text-secondary">
                                    <i class="bi bi-file-earmark-code"></i>
                                </span>
                                <input type="text"
                                       class="form-control bg-dark text-light border-secondary border-opacity-50"
                                       placeholder="e.g. ContactPage"
                                       @bind="_suggestedPoName"
                                       disabled="@_isExtractingPo" />
                            </div>
                            <div class="form-text text-secondary" style="font-size: 0.72rem;">
                                Will be placed in <code>PlaywrightMcpHarness.Tests/Pages/</code>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold text-light mb-1">Custom Architecture Instructions (Optional)</label>
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-light border-secondary border-opacity-50"
                                   placeholder="e.g., Expose FillFormAsync helper, group assertions by section..."
                                   @bind="_extractPoGuidance"
                                   disabled="@_isExtractingPo" />
                            <div class="form-text text-secondary" style="font-size: 0.72rem;">
                                Prompt guidance given to the AI during code refactoring
                            </div>
                        </div>
                    </div>

                    @if (_isExtractingPo)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center p-4 bg-black bg-opacity-40 rounded border border-primary border-opacity-25 text-center" style="min-height: 250px;">
                            <div class="spinner-border text-primary mb-2" role="status"></div>
                            <div class="fw-semibold text-primary">Refactoring Step Definitions into Page Object...</div>
                            <div class="small text-secondary">Encapsulating locators and generating SpecFlow BoDi constructor injection</div>
                        </div>
                    }
                    else if (_extractPoResponse != null && _extractPoResponse.Success)
                    {
                        <!-- Explanation Banner -->
                        <div class="alert alert-info py-2 px-3 small mb-0 border-info border-opacity-25 bg-black bg-opacity-30 d-flex align-items-start gap-2">
                            <i class="bi bi-info-circle-fill text-info mt-1 flex-shrink-0"></i>
                            <div>
                                <strong class="text-light">Architecture Refactor Summary:</strong>
                                <span class="text-secondary ms-1">@_extractPoResponse.Explanation</span>
                            </div>
                        </div>

                        <!-- Diff / Code Preview Tabs -->
                        <div>
                            <ul class="nav nav-pills nav-fill mb-2 bg-black bg-opacity-40 p-1 rounded border border-secondary border-opacity-25">
                                <li class="nav-item">
                                    <button class="nav-link btn-sm py-1 @(_extractPoActiveTab == "pageObject" ? "active bg-primary text-light" : "text-secondary")"
                                            @onclick='() => _extractPoActiveTab = "pageObject"'>
                                        <i class="bi bi-file-earmark-code me-1"></i>New Page Object: Pages/@_extractPoResponse.PageObjectFileName
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link btn-sm py-1 @(_extractPoActiveTab == "stepDefinition" ? "active bg-primary text-light" : "text-secondary")"
                                            @onclick='() => _extractPoActiveTab = "stepDefinition"'>
                                        <i class="bi bi-arrow-repeat me-1"></i>Refactored Steps: @Path.GetFileName(_selectedFilePath)
                                    </button>
                                </li>
                            </ul>

                            @if (_extractPoActiveTab == "pageObject")
                            {
                                <div class="position-relative">
                                    <div class="d-flex justify-content-between align-items-center px-3 py-1 bg-black bg-opacity-60 border-top border-start border-end border-secondary border-opacity-25 rounded-top">
                                        <span class="small font-monospace text-info">Pages/@_extractPoResponse.PageObjectFileName</span>
                                        <button class="btn btn-xs btn-outline-secondary" @onclick='() => CopyToClipboardAsync(_extractPoResponse.GeneratedPageObjectCode)'>
                                            <i class="bi bi-clipboard"></i> Copy
                                        </button>
                                    </div>
                                    <pre class="bg-black p-3 text-info font-monospace small mb-0 border border-secondary border-opacity-25 rounded-bottom" style="max-height: 340px; overflow-y: auto; font-size: 0.82rem; white-space: pre-wrap;">@_extractPoResponse.GeneratedPageObjectCode</pre>
                                </div>
                            }
                            else
                            {
                                <div class="position-relative">
                                    <div class="d-flex justify-content-between align-items-center px-3 py-1 bg-black bg-opacity-60 border-top border-start border-end border-secondary border-opacity-25 rounded-top">
                                        <span class="small font-monospace text-warning">@_selectedFilePath (Refactored to inject @_extractPoResponse.PageObjectClassName)</span>
                                        <button class="btn btn-xs btn-outline-secondary" @onclick='() => CopyToClipboardAsync(_extractPoResponse.RefactoredStepDefinitionCode)'>
                                            <i class="bi bi-clipboard"></i> Copy
                                        </button>
                                    </div>
                                    <pre class="bg-black p-3 text-warning font-monospace small mb-0 border border-secondary border-opacity-25 rounded-bottom" style="max-height: 340px; overflow-y: auto; font-size: 0.82rem; white-space: pre-wrap;">@_extractPoResponse.RefactoredStepDefinitionCode</pre>
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_extractPoErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>@_extractPoErrorMessage
                        </div>
                    }
                </div>

                <div class="modal-footer border-secondary border-opacity-50 py-2 d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="TriggerExtractPageObject" disabled="@_isExtractingPo">
                        <i class="bi bi-arrow-repeat"></i> @(_extractPoResponse != null ? "Re-generate Extraction" : "Generate Extraction")
                    </button>
                    <div class="d-flex align-items-center gap-2">
                        @if (_extractPoResponse != null && _extractPoResponse.Success)
                        {
                            <button type="button" class="btn btn-sm btn-success d-flex align-items-center gap-1 shadow-sm"
                                    @onclick="ApplyExtractPoAsync"
                                    disabled="@_isExtractingPo">
                                <i class="bi bi-check2-circle"></i> Apply & Refactor Suite
                            </button>
                        }
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseExtractPageObjectModal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Page Objects Catalog & Inspector -->
@if (_showPoCatalogModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.85); z-index: 1055;" @onclick="ClosePageObjectCatalogModal">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" @onclick:stopPropagation>
            <div class="modal-content bg-dark text-light border border-secondary shadow-lg" style="max-height: 88vh;">
                <div class="modal-header border-secondary border-opacity-50 py-2 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-layers text-primary fs-5"></i>
                        <div>
                            <h6 class="modal-title mb-0 fw-semibold">Page Objects Catalog</h6>
                            <span class="small text-secondary">
                                @_pageObjects.Count Page Object@(_pageObjects.Count == 1 ? "" : "s") registered in <code>PlaywrightMcpHarness.Tests/Pages/</code>
                            </span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="ClosePageObjectCatalogModal"></button>
                </div>

                <div class="modal-body p-3 d-flex flex-column gap-3" style="overflow-y: auto;">
                    <!-- Search & Filter Bar -->
                    <div class="d-flex align-items-center gap-2">
                        <div class="input-group input-group-sm flex-grow-1">
                            <span class="input-group-text bg-black text-secondary border-secondary border-opacity-50">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text"
                                   class="form-control bg-dark text-light border-secondary border-opacity-50"
                                   placeholder="Filter Page Objects by class, method name, or locator expression..."
                                   @bind="_poCatalogSearchQuery"
                                   @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(_poCatalogSearchQuery))
                            {
                                <button class="btn btn-outline-secondary border-secondary border-opacity-50" @onclick='() => _poCatalogSearchQuery = ""'>
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                        </div>
                        <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 text-nowrap"
                                @onclick="RefreshPageObjectsCatalog">
                            <i class="bi bi-arrow-repeat"></i> Re-scan
                        </button>
                    </div>

                    @if (_pageObjects.Count == 0)
                    {
                        <div class="text-center p-5 bg-black bg-opacity-30 rounded border border-secondary border-opacity-25">
                            <i class="bi bi-layers text-secondary display-5 mb-3 d-block"></i>
                            <h6 class="text-light">No Page Objects Found</h6>
                            <p class="text-secondary small mb-3">
                                No <code>*Page.cs</code> classes currently exist in <code>PlaywrightMcpHarness.Tests/Pages/</code>.
                            </p>
                            <p class="text-secondary small">
                                Select a <code>*Steps.cs</code> file in the editor and click <strong>Extract Page Object</strong> to automatically generate your first Page Object!
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3" style="min-height: 420px;">
                            <!-- Left Column: List of Page Objects -->
                            <div class="col-md-4 d-flex flex-column gap-2" style="max-height: 460px; overflow-y: auto;">
                                @foreach (var po in FilteredPageObjects)
                                {
                                    <div class="card p-2 border @(po == _selectedCatalogPo ? "border-primary bg-primary bg-opacity-10" : "border-secondary border-opacity-25 bg-black bg-opacity-30") cursor-pointer"
                                         style="cursor: pointer;"
                                         @onclick="() => _selectedCatalogPo = po">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="fw-semibold text-light font-monospace small">@po.ClassName</span>
                                            <span class="badge bg-secondary bg-opacity-50 text-light" style="font-size: 0.68rem;">
                                                @po.Methods.Count method@(po.Methods.Count == 1 ? "" : "s")
                                            </span>
                                        </div>
                                        <div class="text-secondary font-monospace" style="font-size: 0.72rem;">@po.FileName</div>
                                        <div class="mt-1 d-flex gap-1 flex-wrap">
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25" style="font-size: 0.65rem;">
                                                <i class="bi bi-crosshair me-1"></i>@po.Locators.Count locator@(po.Locators.Count == 1 ? "" : "s")
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Right Column: Details of Selected Page Object -->
                            <div class="col-md-8 d-flex flex-column gap-3" style="max-height: 460px; overflow-y: auto;">
                                @if (_selectedCatalogPo != null)
                                {
                                    <div class="d-flex align-items-center justify-content-between p-2 bg-black bg-opacity-40 rounded border border-secondary border-opacity-25">
                                        <div>
                                            <div class="fw-bold text-light font-monospace">@_selectedCatalogPo.ClassName</div>
                                            <div class="small text-secondary font-monospace">Pages/@_selectedCatalogPo.FileName</div>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1"
                                                    @onclick="() => NavigateToPageObjectFile(_selectedCatalogPo)">
                                                <i class="bi bi-code-slash"></i> Open in Editor
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Locators Section -->
                                    <div class="card p-2 border-secondary border-opacity-25 bg-black bg-opacity-20">
                                        <div class="fw-semibold small text-info mb-2 d-flex align-items-center gap-1">
                                            <i class="bi bi-crosshair"></i> Encapsulated Locators (@_selectedCatalogPo.Locators.Count)
                                        </div>
                                        @if (_selectedCatalogPo.Locators.Count == 0)
                                        {
                                            <div class="small text-secondary">No locators parsed.</div>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column gap-1">
                                                @foreach (var loc in _selectedCatalogPo.Locators)
                                                {
                                                    <div class="font-monospace small text-light bg-dark p-1 px-2 rounded border border-secondary border-opacity-25 text-truncate" title="@loc">
                                                        @loc
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <!-- Methods Section -->
                                    <div class="card p-2 border-secondary border-opacity-25 bg-black bg-opacity-20">
                                        <div class="fw-semibold small text-success mb-2 d-flex align-items-center gap-1">
                                            <i class="bi bi-braces"></i> Page Action & Assertion Methods (@_selectedCatalogPo.Methods.Count)
                                        </div>
                                        @if (_selectedCatalogPo.Methods.Count == 0)
                                        {
                                            <div class="small text-secondary">No public methods parsed.</div>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var method in _selectedCatalogPo.Methods)
                                                {
                                                    <div class="p-2 bg-dark rounded border border-secondary border-opacity-25">
                                                        <div class="d-flex align-items-center justify-content-between">
                                                            <div class="font-monospace small fw-semibold text-light">
                                                                <span class="text-primary">@method.ReturnType</span> @method.Signature
                                                            </div>
                                                        </div>
                                                        @if (method.Parameters.Count > 0)
                                                        {
                                                            <div class="small text-secondary mt-1 font-monospace" style="font-size: 0.72rem;">
                                                                Params: @string.Join(", ", method.Parameters)
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-secondary small text-center p-4">Select a Page Object from the list to view its locators and action methods.</div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-footer border-secondary border-opacity-50 py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="ClosePageObjectCatalogModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal: Visual Regression & Golden Image Inspector -->
@if (_showVisualModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.85); z-index: 1055;" @onclick="CloseVisualModal">
        <div class="modal-dialog modal-fullscreen-lg-down modal-xl modal-dialog-centered" style="max-width: 95vw; height: 90vh;" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-light border border-secondary shadow-lg d-flex flex-column h-100">
                <!-- Modal Header -->
                <div class="modal-header border-secondary border-opacity-50 py-2 d-flex align-items-center justify-content-between flex-shrink-0">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-images text-danger fs-5"></i>
                        <h5 class="modal-title mb-0 fw-bold">Visual Regression & Golden Image Inspector</h5>
                        <span class="badge bg-secondary bg-opacity-50 ms-2" style="font-size: 0.75rem;">@_visualSnapshots.Count snapshots</span>
                        @if (_visualSnapshots.Any(s => s.HasDiff))
                        {
                            <span class="badge bg-danger ms-1" style="font-size: 0.75rem;">@(_visualSnapshots.Count(s => s.HasDiff)) regressions detected</span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-secondary small d-none d-md-inline">Tolerance: <strong class="text-info">@_config.VisualTolerancePercent%</strong></span>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseVisualModal"></button>
                    </div>
                </div>

                <!-- Modal Body: Split view (List on left, Visual Inspector on right) -->
                <div class="modal-body p-0 d-flex flex-grow-1 overflow-hidden" style="min-height: 0;">
                    <!-- Left Column: Snapshot List & Filters -->
                    <div class="d-flex flex-column border-end border-secondary border-opacity-25" style="width: 320px; min-width: 320px; background-color: #121316;">
                        <div class="p-2 border-bottom border-secondary border-opacity-25 d-flex flex-column gap-2 flex-shrink-0">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-dark border-secondary border-opacity-50 text-secondary">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text" class="form-control bg-dark text-light border-secondary border-opacity-50"
                                       placeholder="Search snapshots..."
                                       @bind="_visualSearchQuery" @bind:event="oninput" />
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <select class="form-select form-select-sm bg-dark text-light border-secondary border-opacity-50"
                                        @bind="_visualStatusFilter">
                                    <option value="All">All Snapshots (@_visualSnapshots.Count)</option>
                                    <option value="Diffs">Diffs Detected (@_visualSnapshots.Count(s => s.HasDiff))</option>
                                    <option value="Baselines">Golden Baselines (@_visualSnapshots.Count(s => s.HasBaseline && !s.HasDiff))</option>
                                </select>
                                <button class="btn btn-sm btn-outline-secondary py-1 px-2"
                                        title="Refresh snapshots"
                                        @onclick="RefreshVisualSnapshotsAsync">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                        </div>

                        <div class="flex-grow-1 overflow-auto p-1">
                            @if (!FilteredVisualSnapshots.Any())
                            {
                                <div class="text-secondary small text-center p-4">
                                    No visual snapshots match the current filter.
                                </div>
                            }
                            else
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var snap in FilteredVisualSnapshots)
                                    {
                                        var isSelected = _selectedVisualSnapshot?.SnapshotName == snap.SnapshotName;
                                        <button type="button"
                                                class="list-group-item list-group-item-action text-light py-2 px-2 border-0 rounded mb-1 d-flex flex-column gap-1 @(isSelected ? "bg-primary bg-opacity-25 border border-primary border-opacity-50" : "bg-dark bg-opacity-50")"
                                                style="cursor: pointer;"
                                                @onclick="() => SelectVisualSnapshot(snap)">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <span class="fw-semibold text-truncate small" style="max-width: 190px;" title="@snap.SnapshotName">
                                                    @snap.SnapshotName
                                                </span>
                                                @if (snap.HasDiff)
                                                {
                                                    <span class="badge bg-danger rounded-pill" style="font-size: 0.65rem;">Diff</span>
                                                }
                                                else if (snap.HasBaseline)
                                                {
                                                    <span class="badge bg-success bg-opacity-25 text-success rounded-pill" style="font-size: 0.65rem;">Clean</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark rounded-pill" style="font-size: 0.65rem;">New</span>
                                                }
                                            </div>
                                            <div class="d-flex align-items-center justify-content-between text-secondary" style="font-size: 0.7rem;">
                                                <span>@(snap.HasBaseline ? "Golden baseline" : "Captured only")</span>
                                                <span>@snap.LastModified.ToString("MMM d, HH:mm")</span>
                                            </div>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Right Column: Inspector Workspace -->
                    <div class="d-flex flex-column flex-grow-1 overflow-hidden" style="min-width: 0;">
                        @if (_selectedVisualSnapshot == null)
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-secondary p-5">
                                <i class="bi bi-images fs-1 text-secondary opacity-50 mb-3"></i>
                                <h5>No Snapshot Selected</h5>
                                <p class="small text-secondary">Select a visual snapshot from the sidebar to inspect golden baselines, pixel differences, and split sliders.</p>
                            </div>
                        }
                        else
                        {
                            <!-- Toolbar for Selected Snapshot -->
                            <div class="d-flex align-items-center justify-content-between p-2 border-bottom border-secondary border-opacity-25 bg-dark flex-shrink-0 flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <h6 class="mb-0 fw-bold text-light d-flex align-items-center gap-2">
                                        <i class="bi bi-file-earmark-image text-danger"></i>
                                        @_selectedVisualSnapshot.SnapshotName
                                    </h6>
                                    @if (_selectedVisualSnapshot.HasDiff)
                                    {
                                        <span class="badge bg-danger">Diff Detected</span>
                                    }
                                    else if (_selectedVisualSnapshot.HasBaseline)
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">Baseline Clean</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">New Baseline</span>
                                    }
                                </div>

                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <!-- View Mode Switcher -->
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn @(_visualViewMode == "curtain" ? "btn-primary" : "btn-outline-secondary")"
                                                @onclick='() => _visualViewMode = "curtain"' title="Interactive Curtain Split Slider">
                                            <i class="bi bi-layout-split me-1"></i>Curtain Slider
                                        </button>
                                        <button type="button" class="btn @(_visualViewMode == "sideBySide" ? "btn-primary" : "btn-outline-secondary")"
                                                @onclick='() => _visualViewMode = "sideBySide"' title="Side-by-side 3-way comparison">
                                            <i class="bi bi-columns me-1"></i>3-Way Split
                                        </button>
                                        <button type="button" class="btn @(_visualViewMode == "diffOnly" ? "btn-primary" : "btn-outline-secondary")"
                                                @onclick='() => _visualViewMode = "diffOnly"' title="Diff highlight only">
                                            <i class="bi bi-magic me-1"></i>Diff Only
                                        </button>
                                    </div>

                                    @if (_selectedVisualSnapshot.HasActual)
                                    {
                                        <button class="btn btn-sm btn-success d-flex align-items-center gap-1 shadow-sm"
                                                title="Promote the actual screenshot to replace the current golden baseline"
                                                @onclick="() => AcceptBaseline(_selectedVisualSnapshot)">
                                            <i class="bi bi-check2-circle"></i> Accept as New Baseline
                                        </button>
                                    }

                                    @if (_selectedVisualSnapshot.HasBaseline)
                                    {
                                        <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1"
                                                title="Delete this golden baseline reference"
                                                @onclick="() => DeleteBaseline(_selectedVisualSnapshot)">
                                            <i class="bi bi-trash"></i> Delete Baseline
                                        </button>
                                    }

                                    @if (_selectedVisualSnapshot.HasDiff)
                                    {
                                        <button class="btn btn-sm btn-outline-info d-flex align-items-center gap-1"
                                                title="Send diff diagnostics to AI agent"
                                                @onclick="() => SendVisualDiffToAgent(_selectedVisualSnapshot)">
                                            <i class="bi bi-robot"></i> Fix with Agent
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Inspection Canvas -->
                            <div class="flex-grow-1 p-2 overflow-auto" style="min-height: 0;">
                                @if (_visualViewMode == "curtain")
                                {
                                    <div class="d-flex flex-column gap-2 h-100">
                                        <div class="d-flex align-items-center justify-content-between px-3 py-1 bg-dark bg-opacity-75 rounded border border-secondary border-opacity-25 flex-shrink-0">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">◀ Baseline (Left: @_curtainSliderPos%)</span>
                                                <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-25">Actual (Right: @(100 - _curtainSliderPos)%) ▶</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2 flex-grow-1 mx-4" style="max-width: 450px;">
                                                <span class="small text-secondary">0%</span>
                                                <input type="range" class="form-range" min="0" max="100" @bind="_curtainSliderPos" @bind:event="oninput" id="curtainRangeSlider" />
                                                <span class="small text-secondary">100%</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-1">
                                                <button class="btn btn-xs btn-outline-secondary" @onclick="() => _curtainSliderPos = 100">All Baseline</button>
                                                <button class="btn btn-xs btn-outline-secondary" @onclick="() => _curtainSliderPos = 50">50/50 Split</button>
                                                <button class="btn btn-xs btn-outline-secondary" @onclick="() => _curtainSliderPos = 0">All Actual</button>
                                            </div>
                                        </div>

                                        <div class="position-relative flex-grow-1 overflow-auto d-flex justify-content-center align-items-center p-3 rounded border border-secondary border-opacity-25"
                                             style="background: repeating-conic-gradient(#1a1d20 0% 25%, #141619 0% 50%) 50% / 20px 20px; min-height: 480px;">
                                            @if (!string.IsNullOrEmpty(_selectedVisualSnapshot.BaselineUrl) && !string.IsNullOrEmpty(_selectedVisualSnapshot.ActualUrl))
                                            {
                                                <div class="position-relative shadow-lg border border-secondary border-opacity-50 rounded" style="max-width: 100%; max-height: 70vh; display: inline-block;">
                                                    <!-- Baseline Image (Bottom Layer) -->
                                                    <img src="@_selectedVisualSnapshot.BaselineUrl" alt="Baseline"
                                                         class="d-block user-select-none" style="max-width: 100%; max-height: 70vh; object-fit: contain;" />

                                                    <!-- Actual Image (Top Layer, Clipped to curtain position) -->
                                                    <img src="@_selectedVisualSnapshot.ActualUrl" alt="Actual"
                                                         class="d-block position-absolute top-0 start-0 user-select-none"
                                                         style="width: 100%; height: 100%; object-fit: contain; clip-path: polygon(@_curtainSliderPos% 0, 100% 0, 100% 100%, @_curtainSliderPos% 100%);" />

                                                    <!-- Vertical Split Divider Handle -->
                                                    <div class="position-absolute top-0 bottom-0 pointer-events-none"
                                                         style="left: @_curtainSliderPos%; width: 2px; background-color: #38bdf8; box-shadow: 0 0 8px #38bdf8; z-index: 5;">
                                                        <div class="position-absolute rounded-circle shadow-lg d-flex align-items-center justify-content-center text-dark"
                                                             style="top: 50%; left: -14px; width: 28px; height: 28px; background: #38bdf8; transform: translateY(-50%); font-size: 14px;">
                                                            <i class="bi bi-arrow-left-right"></i>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else if (!string.IsNullOrEmpty(_selectedVisualSnapshot.ActualUrl))
                                            {
                                                <div class="text-center p-4">
                                                    <div class="alert alert-warning d-inline-block text-start mb-3">
                                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                                        <strong>No baseline exists yet for this snapshot.</strong>
                                                        <div>Click <strong>Accept as New Baseline</strong> above to establish this screenshot as the golden reference.</div>
                                                    </div>
                                                    <div>
                                                        <img src="@_selectedVisualSnapshot.ActualUrl" alt="Actual"
                                                             class="rounded border border-warning shadow-lg" style="max-width: 80%; max-height: 60vh;" />
                                                    </div>
                                                </div>
                                            }
                                            else if (!string.IsNullOrEmpty(_selectedVisualSnapshot.BaselineUrl))
                                            {
                                                <div class="text-center p-4">
                                                    <div class="text-secondary small mb-2"><i class="bi bi-check-circle text-success me-1"></i>Golden Baseline Reference (No actual test diff currently captured)</div>
                                                    <img src="@_selectedVisualSnapshot.BaselineUrl" alt="Baseline"
                                                         class="rounded border border-secondary shadow-lg" style="max-width: 80%; max-height: 60vh;" />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else if (_visualViewMode == "sideBySide")
                                {
                                    <div class="row g-3 h-100 overflow-auto p-2">
                                        <!-- Golden Baseline -->
                                        <div class="col-md-4 d-flex flex-column">
                                            <div class="card bg-dark border-secondary border-opacity-50 h-100 shadow-sm d-flex flex-column">
                                                <div class="card-header bg-dark border-secondary border-opacity-25 d-flex align-items-center justify-content-between py-2">
                                                    <span class="fw-semibold small text-success d-flex align-items-center gap-1">
                                                        <i class="bi bi-shield-check"></i> Golden Baseline
                                                    </span>
                                                    @if (_selectedVisualSnapshot.HasBaseline)
                                                    {
                                                        <span class="badge bg-success bg-opacity-25 text-success" style="font-size: 0.7rem;">Active Reference</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary" style="font-size: 0.7rem;">Missing</span>
                                                    }
                                                </div>
                                                <div class="card-body d-flex align-items-center justify-content-center p-2 flex-grow-1" style="background-color: #121316; min-height: 300px;">
                                                    @if (!string.IsNullOrEmpty(_selectedVisualSnapshot.BaselineUrl))
                                                    {
                                                        <img src="@_selectedVisualSnapshot.BaselineUrl" alt="Baseline" class="img-fluid rounded border border-secondary border-opacity-25 shadow-sm" style="max-height: 55vh; object-fit: contain;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="text-secondary small text-center p-3">No golden baseline saved yet.</div>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Actual Screenshot -->
                                        <div class="col-md-4 d-flex flex-column">
                                            <div class="card bg-dark border-secondary border-opacity-50 h-100 shadow-sm d-flex flex-column">
                                                <div class="card-header bg-dark border-secondary border-opacity-25 d-flex align-items-center justify-content-between py-2">
                                                    <span class="fw-semibold small text-info d-flex align-items-center gap-1">
                                                        <i class="bi bi-camera"></i> Actual Test Render
                                                    </span>
                                                    @if (_selectedVisualSnapshot.HasActual)
                                                    {
                                                        <span class="badge bg-info bg-opacity-25 text-info" style="font-size: 0.7rem;">Captured</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary" style="font-size: 0.7rem;">No Recent Run</span>
                                                    }
                                                </div>
                                                <div class="card-body d-flex align-items-center justify-content-center p-2 flex-grow-1" style="background-color: #121316; min-height: 300px;">
                                                    @if (!string.IsNullOrEmpty(_selectedVisualSnapshot.ActualUrl))
                                                    {
                                                        <img src="@_selectedVisualSnapshot.ActualUrl" alt="Actual" class="img-fluid rounded border border-info border-opacity-25 shadow-sm" style="max-height: 55vh; object-fit: contain;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="text-secondary small text-center p-3">No actual screenshot captured in the last run.</div>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Highlighted Diff -->
                                        <div class="col-md-4 d-flex flex-column">
                                            <div class="card bg-dark border-secondary border-opacity-50 h-100 shadow-sm d-flex flex-column">
                                                <div class="card-header bg-dark border-secondary border-opacity-25 d-flex align-items-center justify-content-between py-2">
                                                    <span class="fw-semibold small text-danger d-flex align-items-center gap-1">
                                                        <i class="bi bi-magic"></i> Highlighted Pixel Diff
                                                    </span>
                                                    @if (_selectedVisualSnapshot.HasDiff)
                                                    {
                                                        <span class="badge bg-danger" style="font-size: 0.7rem;">Diff Detected</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success bg-opacity-25 text-success" style="font-size: 0.7rem;">Identical / Clean</span>
                                                    }
                                                </div>
                                                <div class="card-body d-flex align-items-center justify-content-center p-2 flex-grow-1" style="background-color: #121316; min-height: 300px;">
                                                    @if (!string.IsNullOrEmpty(_selectedVisualSnapshot.DiffUrl))
                                                    {
                                                        <img src="@_selectedVisualSnapshot.DiffUrl" alt="Diff" class="img-fluid rounded border border-danger border-opacity-50 shadow-sm" style="max-height: 55vh; object-fit: contain;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="text-success small text-center p-3">
                                                            <i class="bi bi-check-circle-fill fs-3 d-block mb-2 text-success"></i>
                                                            No visual difference detected! Actual render matches baseline within tolerance.
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (_visualViewMode == "diffOnly")
                                {
                                    <div class="d-flex flex-column align-items-center justify-content-center p-3 h-100 overflow-auto" style="background-color: #121316;">
                                        @if (!string.IsNullOrEmpty(_selectedVisualSnapshot.DiffUrl))
                                        {
                                            <div class="text-center mb-2">
                                                <span class="badge bg-danger px-3 py-1">
                                                    <i class="bi bi-magic me-1"></i>Magenta Pixels (#FF0064) represent altered or shifted UI elements
                                                </span>
                                            </div>
                                            <img src="@_selectedVisualSnapshot.DiffUrl" alt="Diff"
                                                 class="rounded border border-danger border-opacity-50 shadow-lg"
                                                 style="max-width: 95%; max-height: 65vh; object-fit: contain;" />
                                        }
                                        else
                                        {
                                            <div class="text-center text-success p-5">
                                                <i class="bi bi-check-circle-fill fs-1 text-success mb-3 d-block"></i>
                                                <h5>No Visual Diff Detected</h5>
                                                <p class="text-secondary small">This golden baseline matches the actual screenshot perfectly or no test diff is present.</p>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-secondary border-opacity-50 py-2 d-flex justify-content-between flex-shrink-0">
                    <div class="small text-secondary">
                        <i class="bi bi-info-circle me-1"></i>
                        Golden references stored in <code>PlaywrightMcpHarness.Tests/VisualBaselines/</code>. Ephemeral test diffs stored in <code>TestArtifacts/visual/</code>.
                    </div>
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseVisualModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .cursor-blink {
        display: inline-block;
        animation: blink 1s infinite;
        font-weight: bold;
        color: #38bdf8;
    }

    @@keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    .btn-xs {
        padding: 0.15rem 0.45rem;
        font-size: 0.75rem;
    }
</style>

@code {
    private HarnessConfig _config = new();
    private string _selectedProviderKey = "GoogleGemini";
    private LlmProviderConfig _currentProviderOverride = new();
    private PlaywrightMcpConfig _currentMcpOverride = new();
    private string _playwrightServerUrl = "";
    private VisualExecutionMode _selectedVisualMode = VisualExecutionMode.HeadedSlowMo;
    private string _targetScope = "all";
    private bool _runInParallel = false;

    private string _statusText = "Ready";
    private bool _isAgentBusy;
    private bool _isTestRunning;
    private string _promptInput = "";
    private string _streamingChunk = "";
    private CancellationTokenSource? _agentCts;
    private CancellationTokenSource? _testCts;

    private List<TestFileInfo> _testFiles = new();
    private string _selectedFilePath = "";
    private string _currentFileContent = "";

    private readonly List<string> _testConsoleOutput = new();
    private string _activeConsoleTab = "terminal";
    private readonly List<ScenarioResult> _testScenarios = new();
    private bool _showSettingsModal;
    private bool _showDeleteConfirm;
    private bool _isEditorFullScreen;
    private bool _isChatCollapsed;
    private bool _showToolsDropdown;
    private bool _showRunSettingsDropdown;
    private int _lastTestExitCode;
    private DotNetObjectReference<Studio>? _dotNetRef;

    private string GetRunSettingsSummary()
    {
        var mode = _selectedVisualMode switch
        {
            VisualExecutionMode.HeadedSlowMo => "Slow-Mo",
            VisualExecutionMode.HeadedNormal => "Headed",
            VisualExecutionMode.Inspector => "Inspector",
            _ => "Headless"
        };
        var scope = _targetScope == "selected" ? "File" : "All";
        var concurrency = _runInParallel ? "Parallel" : "Seq";
        return $"{mode} • {scope} • {concurrency}";
    }

    private bool HasTestFailures =>
        _testScenarios.Any(s => !s.Passed) ||
        _lastTestExitCode != 0 ||
        _testConsoleOutput.Any(l => l.Contains("Failed!", StringComparison.OrdinalIgnoreCase) ||
                                    l.Contains("Failed ", StringComparison.OrdinalIgnoreCase) ||
                                    l.Contains("Error Message:", StringComparison.OrdinalIgnoreCase) ||
                                    l.Contains("Test Run Failed", StringComparison.OrdinalIgnoreCase));

    private ScenarioResult? _previewScenarioScreenshot;

    private bool _showVisualModal;
    private List<VisualSnapshotItem> _visualSnapshots = new();
    private VisualSnapshotItem? _selectedVisualSnapshot;
    private string _visualSearchQuery = "";
    private string _visualStatusFilter = "All";
    private string _visualViewMode = "curtain";
    private int _curtainSliderPos = 50;

    private IEnumerable<VisualSnapshotItem> FilteredVisualSnapshots
    {
        get
        {
            var list = _visualSnapshots.AsEnumerable();
            if (_visualStatusFilter == "Diffs")
            {
                list = list.Where(s => s.HasDiff);
            }
            else if (_visualStatusFilter == "Baselines")
            {
                list = list.Where(s => s.HasBaseline && !s.HasDiff);
            }

            if (!string.IsNullOrWhiteSpace(_visualSearchQuery))
            {
                var q = _visualSearchQuery.Trim();
                list = list.Where(s => s.SnapshotName.Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            return list;
        }
    }

    private bool _showStepCatalogModal;
    private string _stepSearchQuery = "";
    private string _stepFilterType = "All";

    private IEnumerable<StepDefinitionInfo> FilteredCatalogSteps
    {
        get
        {
            var steps = StepCatalog.Steps.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_stepFilterType) && !_stepFilterType.Equals("All", StringComparison.OrdinalIgnoreCase))
            {
                steps = steps.Where(s => s.StepType.Equals(_stepFilterType, StringComparison.OrdinalIgnoreCase));
            }
            if (!string.IsNullOrWhiteSpace(_stepSearchQuery))
            {
                var q = _stepSearchQuery.Trim();
                steps = steps.Where(s =>
                    s.NormalizedPattern.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    s.MethodName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    s.SourceFile.Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            return steps;
        }
    }

    private void OpenStepCatalogModal()
    {
        _stepSearchQuery = "";
        _stepFilterType = "All";
        _showStepCatalogModal = true;
