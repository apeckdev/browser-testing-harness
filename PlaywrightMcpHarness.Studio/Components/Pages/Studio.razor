    private string GetEditorModeForFile(string path)
    {
        if (string.IsNullOrEmpty(path)) return "text/plain";
        if (path.EndsWith(".feature", StringComparison.OrdinalIgnoreCase)) return "text/x-gherkin";
        if (path.EndsWith(".cs", StringComparison.OrdinalIgnoreCase)) return "text/x-csharp";
        return "text/plain";
    }

