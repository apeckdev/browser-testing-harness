    private string GetConsoleLineClass(string line)
    {
        var trimmed = line.TrimStart();
        if (trimmed.StartsWith("Passed ", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("Passed!", StringComparison.OrdinalIgnoreCase))
        {
            return "text-success fw-bold";
        }
        if (trimmed.StartsWith("Failed ", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("Failed!", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("[ERR]") || trimmed.Contains("Error Message:", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("[VISUAL_DIFF_FAILED]"))
        {
            return "text-danger fw-bold";
        }
        if (trimmed.StartsWith("[VISUAL_DIFF_PASSED]") || trimmed.StartsWith("[VISUAL_BASELINE_CREATED]"))
        {
            return "text-info fw-semibold";
        }
        if (trimmed.StartsWith("Given ", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("When ", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("Then ", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("And ", StringComparison.OrdinalIgnoreCase))
        {
            return "text-info fw-semibold";
        }
        if (trimmed.StartsWith("-> done:", StringComparison.OrdinalIgnoreCase))
        {
            return "text-success text-opacity-75 ps-3";
        }
        if (trimmed.StartsWith("-> error:", StringComparison.OrdinalIgnoreCase))
        {
            return "text-danger fw-bold ps-3";
        }
        if (trimmed.StartsWith("===") || trimmed.StartsWith("[Runner]"))
        {
            return "text-primary fw-semibold";
        }
        if (trimmed.StartsWith("Standard Output Messages:", StringComparison.OrdinalIgnoreCase))
        {
            return "text-secondary fst-italic";
        }
        return "text-light text-opacity-75";
    }

