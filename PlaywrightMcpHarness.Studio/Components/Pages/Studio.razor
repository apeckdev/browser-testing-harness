    private async Task SaveFileContentAsync(string? explicitContent)
    {
        if (string.IsNullOrEmpty(_selectedFilePath))
        {
            return;
        }

        if (explicitContent != null)
        {
            _currentFileContent = explicitContent;
            await SyncEditorToCurrentFileAsync();
        }
        else
        {
            try
            {
                var latest = await JS.InvokeAsync<string>("studioCodeEditor.getValue");
                if (latest != null)
                {
                    _currentFileContent = latest;
                }
            }
            catch { }
        }

        _statusText = $"Saving {Path.GetFileName(_selectedFilePath)}...";
        var res = await AgentService.SaveFileDirectAsync(_selectedFilePath, _currentFileContent);
        _statusText = res;
        await RefreshTestFiles(_selectedFilePath);
    }

    private async Task RunSpecFlowTests()
    {
        if (_isTestRunning)
        {
            return;
        }

        _isTestRunning = true;
        _statusText = $"Starting SpecFlow tests ({_selectedVisualMode})...";
        _testCts = new CancellationTokenSource();

        _testConsoleOutput.Clear();
        _testScenarios.Clear();
        _testConsoleOutput.Add($"=== SpecFlow Test Execution Started: {DateTime.Now:HH:mm:ss} ===");
        _testConsoleOutput.Add($"Visual Mode: {_selectedVisualMode}");
        _testConsoleOutput.Add($"Concurrency: {(_runInParallel ? "Parallel" : "Sequential (1 window at a time)")}");
        _testConsoleOutput.Add($"Target Scope: {(_targetScope == "selected" ? $"Selected File ({GetSelectedTargetLabel()})" : "All Features")}");
        _ = ScrollConsoleToBottomAsync(force: true);

        try
        {
            var options = new TestRunOptions
            {
                Mode = _selectedVisualMode,
                RunInParallel = _runInParallel,
                TargetScope = _targetScope,
                SelectedFilePath = _selectedFilePath
            };

            var exitCode = await TestRunner.RunTestsAsync(
                options,
                line =>
                {
                    InvokeAsync(async () =>
                    {
                        _testConsoleOutput.Add(line);
                        ParseScenarioLine(line);
                        StateHasChanged();
                        await ScrollConsoleToBottomAsync();
                    });
                },
                _testCts.Token);

            _lastTestExitCode = exitCode;
            _statusText = exitCode == 0 ? "Tests passed" : $"Tests failed (exit code {exitCode})";
        }
        catch (OperationCanceledException)
        {
            _statusText = "Tests execution cancelled.";
        }
        catch (Exception ex)
        {
            _statusText = $"Test runner error: {ex.Message}";
        }
        finally
        {
            _isTestRunning = false;
            _testCts?.Dispose();
            _testCts = null;
            ValidateScenarioArtifacts();
            await InvokeAsync(StateHasChanged);
            _ = ScrollConsoleToBottomAsync();
        }
    }

    private void ValidateScenarioArtifacts()
    {
        try
        {
            var artifactsDir = TestRunner.GetTestArtifactsPath();
            var tracesDir = Path.Combine(artifactsDir, "traces");
            var screenshotsDir = Path.Combine(artifactsDir, "screenshots");
            var visualDir = Path.Combine(artifactsDir, "visual");

            foreach (var sc in _testScenarios)
            {
                var sanitized = System.Text.RegularExpressions.Regex.Replace(sc.Name, @"[^a-zA-Z0-9_\-]", "_");
                if (Directory.Exists(tracesDir) && File.Exists(Path.Combine(tracesDir, $"{sanitized}.zip")))
                {
                    sc.TraceFileName = $"{sanitized}.zip";
                }
                else
                {
                    sc.TraceFileName = null;
                }

                if (Directory.Exists(screenshotsDir) && File.Exists(Path.Combine(screenshotsDir, $"{sanitized}.png")))
                {
                    sc.ScreenshotFileName = $"{sanitized}.png";
                }
                else
                {
                    sc.ScreenshotFileName = null;
                }

                if (Directory.Exists(visualDir) && (File.Exists(Path.Combine(visualDir, $"{sanitized}.diff.png")) || File.Exists(Path.Combine(visualDir, $"{sanitized}.actual.png"))))
                {
                    sc.VisualDiffSnapshotName = sanitized;
                }
            }

            _ = InvokeAsync(async () =>
            {
                _visualSnapshots = await VisualSnapshotService.GetVisualSnapshotsAsync(forceReload: true);
                StateHasChanged();
            });
        }
        catch { }
    }

