    private async Task SendPromptToAgent()
    {
        if (string.IsNullOrWhiteSpace(_promptInput) || _isAgentBusy)
        {
            return;
        }

        var prompt = _promptInput.Trim();
        _promptInput = "";
        _streamingChunk = "";
        _isAgentBusy = true;
        _agentCts = new CancellationTokenSource();

        try
        {
            _ = ScrollChatToBottomAsync();
            await AgentService.ExecutePromptAsync(prompt, _selectedProviderKey, _currentProviderOverride, _currentMcpOverride, _agentCts.Token);
            await RefreshTestFiles();
        }
        catch (OperationCanceledException)
        {
            _statusText = "Agent cancelled.";
        }
        catch (Exception ex)
        {
            _statusText = $"Agent error: {ex.Message}";
        }
        finally
        {
            _streamingChunk = "";
            _isAgentBusy = false;
            _agentCts?.Dispose();
            _agentCts = null;
            await InvokeAsync(StateHasChanged);
            _ = ScrollChatToBottomAsync();
        }
    }

